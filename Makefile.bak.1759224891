.PHONY: train start stop restart status smoke

train:
	./scripts/train_all.sh

start:
	sudo systemctl start collectors-merge.service

stop:
	sudo systemctl stop collectors-merge.service

restart:
	sudo systemctl restart collectors-merge.service

status:
	systemctl status collectors-merge.service --no-pager

smoke:
	set -e; \
	for c in lego diecast mtg lorcana fab warhammer gunpla designer_toys; do \
	  echo "-> $$c"; \
	  curl -sS -X POST http://127.0.0.1:8081/predict/$$c \
	    -H 'Content-Type: application/json' \
	    -d '{"title":"sealed limited edition","condition":"new"}' | jq '.category,.suggested_price,.confidence' ; \
	done
