.PHONY: setup run fmt lint test calib export-pdf export-tax ingest-ebay
setup:
\tpython -m pip install -U pip
\tpip install -r requirements.txt

run:
\t./deploy/run_uvicorn.sh

fmt:
\tpython -m black services || true

lint:
\tpython -m ruff services || true

test:
\tpytest -q || true

calib:
\tpython services/collectors_merge/workers/calibration_job.py

export-pdf:
\tpython services/collectors_merge/scripts/export_insurance_pdf.py portfolio_export.json portfolio_insurance.pdf
\t@echo "PDF -> portfolio_insurance.pdf"

export-tax:
\tpython services/collectors_merge/scripts/export_tax_csv.py realized.jsonl tax_export.csv
\t@echo "CSV -> tax_export.csv"

ingest-ebay:
\tpython services/collectors_merge/workers/ingest_ebay_sold.py ebay_sold.jsonl
