APP := $(HOME)/collectors-merge-recovered
PY  := $(APP)/.venv/bin/python3

.PHONY: status restart tail smoke nightly backup
status: ; sudo systemctl status collectors-merge.service --no-pager
restart: ; sudo systemctl restart collectors-merge.service
tail: ; journalctl -u collectors-merge.service -n 120 --no-pager
smoke: ; bash scripts/smoke_api.sh
nightly: ; bash scripts/nightly.sh
backup: ; bash scripts/backup_state.sh
