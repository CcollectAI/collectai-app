from __future__ import annotations
import os
from pathlib import Path
from typing import Any, Dict, Optional, Tuple

from fastapi import FastAPI, Request, HTTPException
from app.ml.infer import suggest as _ml_suggest, Query
from fastapi.responses import JSONResponse

# ---- local-only resolver (we rely on your existing app/resolver_local.py) ----
from app.resolver_local import resolve_version, resolve_model_path, resolve_meta  # noqa: F401

app = FastAPI(title="Collectors Merge API (minimal)")

# ------------------------------- utilities -----------------------------------
def _fallback_model_path(category: str, version: Optional[str]) -> Optional[str]:
    """
    1) artifacts/<cat>/<version>/model.pkl
    2) artifacts/<cat>/active/model.pkl
    """
    if category:
        if version:
            p = Path("artifacts")/category/version/"model.pkl"
            if p.exists():
                return str(p)
        p2 = Path("artifacts")/category/"active"/"model.pkl"
        if p2.exists():
            return str(p2)
    return None

def _choose_path(category: str, version: Optional[str]) -> Tuple[Optional[str], str]:
    """
    Ask resolver_local first; if it yields nothing, hard fallback.
    """
    chosen, _src = resolve_version(category, explicit_version=version)
    p = resolve_model_path(category, chosen)
    if not p:
        p = _fallback_model_path(category, chosen)
        if p:
            return p, "fallback"
        return None, "none"
    return p, "resolver"

def _load_model(path: str):
    import joblib
    obj = joblib.load(path)
    # unwrap dict-like artifacts that store under common keys
    if isinstance(obj, dict):
        for k in ("model", "estimator", "pipeline", "clf", "reg", "best_estimator_"):
            if k in obj:
                return obj[k]
    return obj

def _as_float(x: Any, default: float = 0.0) -> float:
    try:
        return float(x)
    except Exception:
        return default

def _vec_from_features(category: str, title: str, item_id: str, features: Dict[str, Any]) -> list[float]:
    """
    Produce a 6-float vector compatible with the tiny DummyRegressor pipelines you created.
    - lego: piece_count, year, theme_popularity, sealed(0/1), box_condition_score, recent_sale_z
    - diecast: year, package_condition_score, recent_sale_z, len(title), (id tail hash), constant 1.0
    """
    if category == "lego":
        return [
            _as_float(features.get("piece_count")),
            _as_float(features.get("year")),
            _as_float(features.get("theme_popularity")),
            1.0 if bool(features.get("sealed")) else 0.0,
            _as_float(features.get("box_condition_score")),
            _as_float(features.get("recent_sale_z")),
        ]
    # default/diecast
    tail = 0.0
    try:
        tail = int(item_id[-2:], 16) % 100 if "-" in item_id else (hash(item_id) % 100)
    except Exception:
        tail = 0.0
    return [
        _as_float(features.get("year")),
        _as_float(features.get("package_condition_score")),
        _as_float(features.get("recent_sale_z")),
        float(len(title or "")),
        float(tail),
        1.0,
    ]

# --------------------------------- routes ------------------------------------
@app.get("/health")
def health() -> Dict[str, bool]:
    return {"ok": True}

@app.post("/suggest")
async def suggest(request: Request, version: Optional[str] = Query(default=None)) -> JSONResponse:
    """
    Body (no strict pydantic; we accept plain JSON):
    {
      "id": "uuid",            // required
      "title": "string",
      "condition": "new|mint|…",
      "category": "diecast|lego",   // required
      "features": { ... }           // per-category fields
    }
    """
    try:
        body = await request.json()
    except Exception:
        raise HTTPException(status_code=400, detail="invalid_json")

    if not isinstance(body, dict):
        raise HTTPException(status_code=422, detail="body_must_be_object")

    item_id = body.get("id")
    category = body.get("category")
    title = body.get("title") or ""
    features = body.get("features") or {}

    if not item_id:
        raise HTTPException(status_code=422, detail="missing_id")
    if not category:
        raise HTTPException(status_code=422, detail="missing_category")
    if not isinstance(features, dict):
        raise HTTPException(status_code=422, detail="features_must_be_object")

    # choose model path (local-only)
    model_path, source = _choose_path(category, version)
    if not model_path:
        raise HTTPException(status_code=404, detail=f"No model for {category}")

    # load model
    try:
        model = _load_model(model_path)
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Model load failed: {type(e).__name__}")

    # build feature vector → predict
    try:
        import numpy as np
        x = _vec_from_features(category, title, item_id, features)
        X = np.array([x], dtype=float)
        # sklearn-like API
        if hasattr(model, "predict"):
            y = model.predict(X)
            price = float(y[0])
        else:
            # non-sklearn object; best-effort score/forward
            if hasattr(model, "forward"):
                out = model.forward(X)  # type: ignore
                price = float(getattr(out, "item", lambda: out)())
            elif hasattr(model, "__call__"):
                out = model(X)  # type: ignore
                price = float(getattr(out, "item", lambda: out)())
            else:
                raise RuntimeError("model_has_no_predict")
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"inference_failed: {type(e).__name__}")

    resp = {
        "id": item_id,
        "category": category,
        "version": Path(model_path).parts[-2] if "/active/" in model_path else Path(model_path).parts[-2],
        "source": source,
        "suggested_price": price,
    }
    return JSONResponse(resp)
