from __future__ import annotations
from fastapi import APIRouter, UploadFile, File, Form, HTTPException
from typing import Dict, Any, List
from datetime import datetime
import os, json
import psycopg2, psycopg2.extras

router = APIRouter()

def db():
    import os
    return psycopg2.connect(os.environ["DATABASE_URL"])

def fake_model_predict(attrs: Dict[str, Any]) -> Dict[str, float]:
    base = 120.0
    m = 1.0
    if attrs.get("grade") == "PSA 10": m = 1.4
    if not attrs.get("sealed"): m *= 0.9
    q50 = base*m
    return {"q10": q50*0.75, "q50": q50, "q90": q50*1.25}

@router.post("/ingest/photo")
async def ingest_photo(image: UploadFile = File(...), to: str = Form("portfolio")) -> Dict[str, Any]:
    # TODO: persist image; return a client-side draft
    attrs = {"sealed": False}
    return {"ok": True, "draft_item": {"attributes": attrs}, "to": to}

@router.post("/items/upsert")
async def items_upsert(item: Dict[str, Any]) -> Dict[str, Any]:
    """
    Upsert basic item details. Returns item_id.
    """
    required = ["user_id","category"]
    if not all(k in item for k in required):
        raise HTTPException(400, f"Missing fields: {required}")
    q = """
    insert into public.items (user_id, category, normalized_key, title, condition, grade, graded_by, sealed, attributes_json, images)
    values (%(user_id)s, %(category)s, %(normalized_key)s, %(title)s, %(condition)s, %(grade)s, %(graded_by)s, %(sealed)s, %(attributes_json)s::jsonb, %(images)s::jsonb)
    on conflict do nothing
    returning id;
    """
    conn = db(); cur = conn.cursor()
    cur.execute(q, {
        "user_id": item["user_id"], "category": item["category"].lower(),
        "normalized_key": item.get("normalized_key"),
        "title": item.get("title"),
        "condition": item.get("condition"),
        "grade": item.get("grade"),
        "graded_by": item.get("graded_by"),
        "sealed": item.get("sealed"),
        "attributes_json": json.dumps(item.get("attributes_json") or {}),
        "images": json.dumps(item.get("images") or []),
    })
    row = cur.fetchone()
    if row is None:
        # fetch existing by (user_id, normalized_key, title) heuristic
        cur.execute("""select id from public.items
                       where user_id=%s and category=%s and coalesce(normalized_key,'')=coalesce(%s,'') and coalesce(title,'')=coalesce(%s,'')
                       order by created_at desc limit 1""",
                    (item["user_id"], item["category"].lower(), item.get("normalized_key"), item.get("title")))
        row = cur.fetchone()
    item_id = row[0]
    conn.commit(); cur.close(); conn.close()
    return {"ok": True, "item_id": str(item_id)}

@router.post("/predict_v2")
async def predict_v2(payload: Dict[str, Any]) -> Dict[str, Any]:
    attrs = payload.get("attributes") or {}
    item_id = payload.get("item_id")
    if item_id is None:
        raise HTTPException(400, "item_id is required (call /items/upsert first)")
    preds = fake_model_predict(attrs)
    why = []
    if attrs.get("grade") == "PSA 10": why.append("+PSA10")
    if not attrs.get("sealed"): why.append("-Loose/no box")

    # persist
    conn = db(); cur = conn.cursor()
    cur.execute("""
        insert into public.price_predictions (item_id, model_version, y_hat, q10, q50, q90, conf_score, features_used)
        values (%s,%s,%s,%s,%s,%s,%s,%s::jsonb)
    """, (item_id, os.getenv("MODEL_VERSION","v0"), preds["q50"], preds["q10"], preds["q50"], preds["q90"], 0.80, json.dumps({"attrs": attrs, "why": why})))
    conn.commit(); cur.close(); conn.close()

    return {"q10": round(preds["q10"],2), "q50": round(preds["q50"],2), "q90": round(preds["q90"],2), "why": why, "asof": datetime.utcnow().isoformat()+"Z"}

@router.post("/watchlist/add")
async def watchlist_add(payload: Dict[str, Any]) -> Dict[str, Any]:
    user_id = payload.get("user_id"); normalized_key = payload.get("normalized_key")
    if not user_id or not normalized_key:
        raise HTTPException(400, "user_id and normalized_key required")
    conn = db(); cur = conn.cursor()
    cur.execute("""insert into public.watchlist (user_id, normalized_key) values (%s,%s) on conflict do nothing""",
                (user_id, normalized_key))
    conn.commit(); cur.close(); conn.close()
    return {"ok": True}

@router.post("/watchlist/remove")
async def watchlist_remove(payload: Dict[str, Any]) -> Dict[str, Any]:
    user_id = payload.get("user_id"); normalized_key = payload.get("normalized_key")
    if not user_id or not normalized_key:
        raise HTTPException(400, "user_id and normalized_key required")
    conn = db(); cur = conn.cursor()
    cur.execute("""delete from public.watchlist where user_id=%s and normalized_key=%s""", (user_id, normalized_key))
    conn.commit(); cur.close(); conn.close()
    return {"ok": True}

@router.get("/watchlist/list/{user_id}")
async def watchlist_list(user_id: str) -> Dict[str, Any]:
    conn = db(); cur = conn.cursor(cursor_factory=psycopg2.extras.RealDictCursor)
    cur.execute("""select id, normalized_key, created_at from public.watchlist where user_id=%s order by created_at desc""", (user_id,))
    rows = cur.fetchall()
    cur.close(); conn.close()
    return {"ok": True, "items": rows}

@router.post("/items/realized")
async def items_realized(payload: Dict[str, Any]) -> Dict[str, Any]:
    """
    Payload: {item_id, proceeds, fees, cost_basis, sold_at, last_pred: {q10,q50,q90}}
    Writes feedback + calibration row.
    """
    required = ["item_id","proceeds","sold_at"]
    if not all(k in payload for k in required):
        raise HTTPException(400, f"Missing fields: {required}")
    # feedback table
    conn = db(); cur = conn.cursor()
    cur.execute("""insert into public.feedback (item_id, label, observed_at) values (%s,%s,%s)
                """,(payload["item_id"], f"sale_price:{payload['proceeds']}", payload["sold_at"]))
    conn.commit(); cur.close(); conn.close()

    # append calibration row
    from services.collectors_merge.workers.capture_calibration import append_row
    last_pred = payload.get("last_pred") or {}
    append_row({
        "item_id": payload["item_id"],
        "actual": float(payload["proceeds"]),
        "q10": float(last_pred.get("q10") or 0),
        "q50": float(last_pred.get("q50") or 0),
        "q90": float(last_pred.get("q90") or 0),
        "category": payload.get("category","unknown"),
        "asof": payload.get("sold_at")
    })
    return {"ok": True}
