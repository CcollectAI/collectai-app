# --- Item Value History (mock timeseries) ---

from datetime import datetime, timedelta
import random

@app.get("/items/{item_id}/history")
@app.get("/items/{item_id}/history/extended")
async def get_item_history_extended(item_id: str):
    """
    Extended variant: returns history + basic stats.
    """
    import random
    from datetime import datetime, timedelta

    today = datetime.utcnow().date()
    days = [today - timedelta(days=i) for i in range(30)]

    values = [round(100 + random.random()*40, 2) for _ in days]
    history = [{"date": d.isoformat(), "value": v} for d, v in zip(days, values)]

    return {
        "history": history,
        "stats": {
            "min": min(values),
            "max": max(values),
            "avg": sum(values) / len(values),
            "volatility": max(values) - min(values),
        }
    }

async def item_history(item_id: str):
    """
    Mock price history for charts.
    Generates 30 days of random values around 100–150 EUR.
    """
    base = 120.0
    history = []
    today = datetime.utcnow()

    for i in range(30):
        day = today - timedelta(days=i)
        value = base + random.uniform(-15, 15)
        history.append({
            "date": day.strftime("%Y-%m-%d"),
            "value": round(value, 2)
        })

    # Return oldest → newest
    history.reverse()
    return history

