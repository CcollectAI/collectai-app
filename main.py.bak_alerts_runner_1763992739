@app.get("/portfolio/history")
async def portfolio_history(_: bool = Depends(require_api_key)):
    """
    Mock portfolio history for the Portfolio screen chart.
    30-day series + summary stats.
    """
    import random
    from datetime import datetime, timedelta

    today = datetime.utcnow().date()
    values = []
    base_value = 1240.0  # mock portfolio total

    for i in range(30):
        day = today - timedelta(days=i)
        val = base_value + random.uniform(-90, 90)
        values.append({"date": str(day), "value": round(val, 2)})

    values = list(reversed(values))

    vals = [v["value"] for v in values]
    return {
        "series": values,
        "summary": {
            "min": min(vals),
            "max": max(vals),
            "avg": sum(vals) / len(vals),
            "change_1d": vals[-1] - vals[-2],
            "change_7d": vals[-1] - vals[-8],
        },
    }

