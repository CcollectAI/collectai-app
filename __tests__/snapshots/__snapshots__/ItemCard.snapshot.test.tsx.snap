exports[`ItemCard snapshots matches snapshot with condition badge (grading-eligible category) 1`] = `
<View
  accessibilityLabel="Charizard Base Set"
  accessibilityRole="button"
  style={
    {
      "backgroundColor": "#FFFFFF",
