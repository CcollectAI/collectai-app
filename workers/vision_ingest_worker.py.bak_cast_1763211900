#!/usr/bin/env python3
import os, asyncio, logging
import asyncpg
from openai import OpenAI

logging.basicConfig(level=logging.INFO, format="%(asctime)s [vision_ingest] %(levelname)s: %(message)s")

DSN = os.environ.get("DB_DSN")
OPENAI_API_KEY = os.environ.get("OPENAI_API_KEY")

client = OpenAI(api_key=OPENAI_API_KEY)

ZERO_SHOT_LABELS = [
    "pokemon card",
    "funko pop",
    "diecast car",
    "magic the gathering card",
    "lorcana card",
    "flesh and blood card",
    "warhammer miniature",
    "gunpla model kit",
    "designer toy",
]

async def run_once():
    if not DSN:
        logging.error("DB_DSN not set")
        return
    if not OPENAI_API_KEY:
        logging.error("OPENAI_API_KEY not set")
        return

    conn = await asyncpg.connect(DSN)

    rows = await conn.fetch("""
        SELECT id, item_ref
        FROM public.vision_predict_log
        WHERE embedding IS NULL
        ORDER BY created_at ASC
        LIMIT 10;
    """)

    if not rows:
        logging.info("No pending vision logs")
        await conn.close()
        return

    logging.info("Processing %d vision logs", len(rows))

    for r in rows:
        vid = r["id"]
        item_ref = r["item_ref"] or ""

        # 1) embedding for the item_ref text
        emb_resp = client.embeddings.create(
            model="text-embedding-3-small",
            input=item_ref
        )
        emb = emb_resp.data[0].embedding

        # 2) zero-shot label scoring
        sims = []
        for label in ZERO_SHOT_LABELS:
            lab_emb_resp = client.embeddings.create(
                model="text-embedding-3-small",
                input=label
            )
            lab_emb = lab_emb_resp.data[0].embedding
            sim = sum(a * b for a, b in zip(emb, lab_emb))
            sims.append((sim, label))

        best_sim, best_label = max(sims)

        logging.info("vision_id=%s ref=%s label=%s score=%.4f", vid, item_ref, best_label, best_sim)

        await conn.execute(
            """
            UPDATE public.vision_predict_log
            SET embedding = $1,
                predicted_label = $2,
                score = $3
            WHERE id = $4
            """,
            emb,
            best_label,
            float(best_sim),
            vid,
        )

    await conn.close()
    logging.info("Done vision ingestion cycle")

async def main():
    try:
        await run_once()
    except Exception as e:
        logging.exception("vision_ingest_worker crashed: %r", e)

if __name__ == "__main__":
    asyncio.run(main())
