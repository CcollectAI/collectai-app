# --- Minimal Item Detail demo endpoint (no DB, no models) ---

@app.get("/items/{item_id}/detail")
async def get_item_detail_demo_min(item_id: str):
    from datetime import datetime

    # This must be JSON-serializable, so we convert datetime to ISO string.
    as_of = datetime.utcnow().isoformat() + "Z"

    return {
        "id": item_id,
        "name": f"Demo collectible #{item_id[:6]}",
        "category_slug": "funko",
        "estimated_value": 125.0,
        "currency": "EUR",
        "change_1d_pct": 7.5,
        "prediction": {
            "low": 100.0,
            "mid": 125.0,
            "high": 160.0,
            "currency": "EUR",
            "model_name": "demo-valuation-model",
            "as_of": as_of,
        },
        "category_meta": {
            "slug": "funko",
            "label": "Funko Pops",
            "wave": "wave1",
            "avg_value": 80.0,
            "item_count": 42,
            "active": True,
        },
        "signals": [
            {"name": "Recent sales", "value": "Up", "unit": None},
            {"name": "Scarcity", "value": "High", "unit": None},
            {"name": "Collector interest", "value": "Strong", "unit": None},
        ],
        "condition_text": "Near mint",
        "edition_text": "Special edition",
        "series_text": "Wave 1 – Launch",
        "acquisition_price": 60.0,
        "acquisition_currency": "EUR",
        "acquisition_date": "2024-01-15T00:00:00Z",
    }
