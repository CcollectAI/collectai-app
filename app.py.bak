from fastapi import FastAPI, HTTPException
from fastapi.responses import JSONResponse
from pydantic import BaseModel
from typing import Optional, Dict, Any
import os, json, boto3, requests

S3 = boto3.client("s3")
ARTIFACT_BUCKET = os.environ.get("ARTIFACT_BUCKET","collectai-models")
SB = os.environ["SUPABASE_URL"]
KEY = os.environ["SUPABASE_SERVICE_KEY"]

app = FastAPI()

class SuggestIn(BaseModel):
    category: str
    title: str
    condition: str
    attributes: Dict[str, Any] = {}

class FeedbackIn(BaseModel):
    category: str
    version: str
    accepted_price: float
    input: Dict[str, Any] = {}
    suggestion_id: Optional[str] = None
    source: str = "user_accept"
    notes: Optional[str] = None

def _sb(path: str, payload: dict):
    """Minimal Supabase POST helper (service_role key)."""
    h={"apikey":KEY,"Authorization":f"Bearer {KEY}","Content-Type":"application/json"}
    r=requests.post(f"{SB}/rest/v1/{path}", headers=h, json=payload, timeout=10)
    if r.status_code not in (200,201,204):
        print("SB_ERR", path, r.status_code, r.text)
    return r

def get_active_version(category: str) -> str:
    try:
        r = requests.get(
            f"{SB}/rest/v1/model_gate",
            params={"select":"active_version","category":"eq."+category,"limit":"1"},
            headers={"apikey":KEY,"Authorization":f"Bearer {KEY}"},
            timeout=10
        )
        r.raise_for_status()
        data = r.json()
    except requests.RequestException as e:
        raise HTTPException(502, f"gate_lookup_failed:{e}")
    if not data or not data[0].get("active_version"):
        raise HTTPException(404, f"No active model for {category}")
    return data[0]["active_version"]

def load_artifact(model: str, version: str) -> dict:
    key = f"artifacts/{model}/{version}/model.json"
    try:
        obj = S3.get_object(Bucket=ARTIFACT_BUCKET, Key=key)
        return json.loads(obj["Body"].read())
    except Exception:
        raise HTTPException(503, f"artifact_missing:{key}")

def ridge_predict(artifact: dict, features: Dict[str, Any]) -> Optional[float]:
    if artifact.get("model_type") != "ridge_v1":
        return None
    cols = artifact["features"]
    mu  = artifact["standardizer"]["mean"]
    sd  = artifact["standardizer"]["std"]
    coef = artifact["ridge"]["coef"]
    intercept = artifact["ridge"]["intercept"]
    x = []
    for i, c in enumerate(cols):
        v = float(features.get(c, 0.0))
        m = float(mu[i])
        s = float(sd[i]) or 1.0
        x.append((v - m) / s)
    y = float(intercept) + sum(float(ci)*xi for ci, xi in zip(coef, x))
    return float(y)

@app.get("/health")
def health():
    return {"ok": True}

@app.post("/suggest")
def suggest(inp: SuggestIn):
    try:
        ver = get_active_version(inp.category)
        art = load_artifact("price", ver)
        # numeric features only from attributes
        feats = {k: v for k, v in (inp.attributes or {}).items() if isinstance(v, (int, float))}
        y = ridge_predict(art, feats)
        if y is None:
            y = float(art.get("baseline_price_eur", 25.0))
        resp = {
            "category": inp.category,
            "model": "price",
            "version": ver,
            "suggested_price_eur": round(y, 2),
            "range": [round(0.9*y, 2), round(1.1*y, 2)],
            "used": art.get("model_type", "baseline_only")
        }
        try:
            _sb("suggestion_logs", {
                "category": inp.category,
                "model": "price",
                "version": ver,
                "input": inp.model_dump(),
                "prediction": resp["suggested_price_eur"],
                "low": resp["range"][0],
                "high": resp["range"][1],
                "served_via": resp["used"]
            })
        except Exception as e:
            print("log_suggest_err", e)
        return resp
    except HTTPException as e:
        raise e
    except Exception as e:
        return JSONResponse(status_code=500, content={"detail": f"server_error:{e}"})

@app.post("/feedback")
def feedback(inp: FeedbackIn):
    try:
        _sb("feedback", {
            "category": inp.category,
            "model": "price",
            "version": inp.version,
            "accepted_price": float(inp.accepted_price),
            "input": inp.input,
            "suggestion_id": inp.suggestion_id,
            "source": inp.source,
            "notes": inp.notes
        })
    except Exception as e:
        raise HTTPException(500, f"feedback_failed:{e}")
    return {"ok": True}
