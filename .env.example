# --- Storage selection ---
# STORAGE_BACKEND=supabase|s3
STORAGE_BACKEND=supabase

# Supabase
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# AWS (for S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Cache dir
CACHE_DIR=.cache

# DB flags for local/dev CI
DB_ENABLED=false
DATABASE_URL=
DB_SSL_ALLOW_SELF_SIGNED=1
