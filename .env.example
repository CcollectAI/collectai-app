# =============================================================================
# Sparrow Collect Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control - it contains secrets!
# =============================================================================

# -----------------------------------------------------------------------------
# Storage Backend Selection
# -----------------------------------------------------------------------------
# Options: "supabase" or "s3"
# - supabase: Use Supabase for all storage (recommended for development)
# - s3: Use S3 for bulk/ML data, Supabase for app data (production)
STORAGE_BACKEND=supabase

# -----------------------------------------------------------------------------
# Supabase Configuration (Required)
# -----------------------------------------------------------------------------
# Get these from your Supabase project dashboard: Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Direct database connection (for backend services)
SUPABASE_HOST=db.your-project.supabase.co
SUPABASE_DB=postgres
SUPABASE_USER=postgres
SUPABASE_PASS=your-database-password
SUPABASE_PORT=5432

# -----------------------------------------------------------------------------
# AWS / S3 Configuration (Required for S3 storage backend)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1

# S3 bucket for ML model artifacts
ML_MODELS_S3_BUCKET=collectai-ml-models

# S3 bucket for general artifacts (images, exports, etc.)
ARTIFACT_BUCKET=collectai-artifacts

# S3 bucket for catalog item images (defaults to ARTIFACT_BUCKET)
# Images stored at: s3://{bucket}/catalog-images/{category}/{item_key}.jpg
CATALOG_IMAGES_S3_BUCKET=collectai-artifacts

# CloudFront CDN URL for serving cached images (optional but recommended)
# Create a CloudFront distribution pointing to the ARTIFACT_BUCKET
# This gives fast global delivery + HTTPS for ~$0.085/GB
CATALOG_IMAGES_CDN_URL=

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Enable/disable database connectivity
# Set to "false" for offline development, "true" for production
DB_ENABLED=false

# Full database connection string (alternative to individual Supabase vars)
DB_DSN=
DATABASE_URL=

# Optional: Continue running even if DB connection fails
# Set to "1" for graceful degradation, "0" for strict mode
DB_OPTIONAL=0

# Allow self-signed SSL certificates (development only!)
# Set to "0" in production
DB_SSL_ALLOW_SELF_SIGNED=1

# -----------------------------------------------------------------------------
# JWT / Auth (Required for production)
# -----------------------------------------------------------------------------
# Supabase JWT secret — found in Supabase Dashboard > Settings > API > JWT Secret
SUPABASE_JWT_SECRET=
# JWT issuer — your Supabase auth URL (validates iss claim)
# Example: https://your-project.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=
# Dev user ID when DEV_MODE=true and no Bearer token (local dev only)
DEV_USER_ID=dev-user-local
# Ops endpoint API key
OPS_API_KEY=

# -----------------------------------------------------------------------------
# API Security (Required for production)
# -----------------------------------------------------------------------------
# Shared secret for API authentication between services
# Generate with: openssl rand -hex 32
API_SHARED_SECRET=

# Alternative auth key format (if used)
API_AUTH_KEY=

# -----------------------------------------------------------------------------
# Stripe (Payments / Subscriptions)
# -----------------------------------------------------------------------------
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Webhook signing secret (from Stripe Dashboard > Webhooks > Signing secret)
STRIPE_WEBHOOK_SECRET=
# Price IDs for subscription plans (from Stripe Dashboard > Products)
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PREMIUM=
# Sponsored events tiers (one-time payment Price IDs from Stripe Dashboard > Products)
STRIPE_PRICE_ID_SPONSOR_FEATURED=
STRIPE_PRICE_ID_SPONSOR_PROMOTED=
STRIPE_PRICE_ID_SPONSOR_SPOTLIGHT=

# -----------------------------------------------------------------------------
# CORS & Security
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins for CORS
# Development: http://localhost:3000,http://localhost:8080
# Production:  https://app.sparrowcollect.com,https://sparrowcollect.com,https://www.sparrowcollect.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080

# Comma-separated list of trusted hosts (prevents host header attacks)
# Production: api.sparrowcollect.com,sparrowcollect.com,www.sparrowcollect.com
TRUSTED_HOSTS=

# -----------------------------------------------------------------------------
# Service Configuration
# -----------------------------------------------------------------------------
# Version string shown in /version endpoint
SERVICE_VERSION=0.1.0

# Signals API microservice URL
SIGNALS_BASE_URL=http://127.0.0.1:8082

# Enable debug mode (exposes /debug-ping endpoint)
# Set to "false" in production
DEBUG=false

# Directory for caching temporary files
CACHE_DIR=.cache

# Directory for QuickScan temporary image uploads
QUICKSCAN_TMP_DIR=/tmp

# -----------------------------------------------------------------------------
# ML Configuration
# -----------------------------------------------------------------------------
# Use materialized view for Q50 price clamping (1=yes, 0=no)
Q50_USE_CLAMP_MV=1

# -----------------------------------------------------------------------------
# Mobile App Configuration (React Native / Expo)
# -----------------------------------------------------------------------------
# These are prefixed with EXPO_PUBLIC_ for client-side access
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase mode: "strict" (crash if missing creds), "mock" (return empty data), "off"
EXPO_PUBLIC_SUPABASE_MODE=mock

# Sentry DSN for frontend error tracking
EXPO_PUBLIC_SENTRY_DSN=

# Google OAuth Client IDs (from Google Cloud Console > Credentials)
# Create OAuth 2.0 Client IDs for each platform
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# -----------------------------------------------------------------------------
# User Photo Uploads (S3)
# -----------------------------------------------------------------------------
# Per-user photo storage: s3://{bucket}/user-uploads/{user_id}/{item_id}/
USER_UPLOADS_S3_BUCKET=collectai-artifacts
USER_UPLOADS_CDN_URL=
# Max photo size in bytes (default 2MB)
USER_UPLOADS_MAX_SIZE=2097152

# -----------------------------------------------------------------------------
# Newsletter Scraper (Events Pipeline)
# -----------------------------------------------------------------------------
# Dedicated email for receiving collector newsletters
# Sign up at: Funko, LEGO, Bandai, Pokemon Company, WOTC, Good Smile,
#   AmiAmi, CDJapan, Weverse, Hololive Shop, shopDisney, Loungefly, Eventbrite
SCRAPER_EMAIL_HOST=imap.gmail.com
SCRAPER_EMAIL_USER=slendebroekmerle@gmail.com
SCRAPER_EMAIL_PASS=
SCRAPER_EMAIL_PORT=993
SCRAPER_EMAIL_USE_SSL=true
# Comma-separated sender domains to filter (empty = all)
SCRAPER_EMAIL_SENDERS=funko.com,lego.com,bandai.co.jp,pokemon.com,wizards.com,amiami.com,cdjapan.co.jp,weverse.io,shopdisney.com,loungefly.com,eventbrite.com

# -----------------------------------------------------------------------------
# Monitoring / Sentry
# -----------------------------------------------------------------------------
# Sentry DSN for error tracking (get from sentry.io > Project Settings > Client Keys)
SENTRY_DSN=
# Environment tag for Sentry (development, staging, production)
SENTRY_ENV=development
# Traces sample rate (0.0 = none, 1.0 = all, 0.1 = 10% recommended for production)
SENTRY_TRACES_RATE=0.1

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# Global rate limit (requests per minute per IP)
RATE_LIMIT_RPM=60
# Enable/disable rate limiting (set to "true" in production)
RATE_LIMIT_ENABLED=true
# Enable/disable per-user rate limiting for vision/intake endpoints
PER_USER_RATE_LIMIT_ENABLED=true

# -----------------------------------------------------------------------------
# Firecrawl Configuration (Web Scraping / URL Import)
# -----------------------------------------------------------------------------
# Get your API key from https://firecrawl.dev
# Free tier: 500 credits/month; Growth: $19/mo for 3,000 credits
# Each scrape/extract = 1 credit; search = 1 credit per result
FIRECRAWL_API_KEY=

# -----------------------------------------------------------------------------
# Cardmarket (EU TCG Marketplace)
# -----------------------------------------------------------------------------
# Sign up at https://www.cardmarket.com/en/Magic/Account/ApiRegistration
# Covers: pokemon, mtg, yugioh, lorcana (EU pricing)
CARDMARKET_APP_TOKEN=
CARDMARKET_APP_SECRET=

# -----------------------------------------------------------------------------
# Discogs (Vinyl / Music Database)
# -----------------------------------------------------------------------------
# Get personal token at https://www.discogs.com/settings/developers
# Covers: anime_ost_vinyl, anime_soundtrack, kpop_merch, taylor_swift
DISCOGS_PERSONAL_TOKEN=

# -----------------------------------------------------------------------------
# PriceCharting (Retro Game Pricing)
# -----------------------------------------------------------------------------
# Get API key at https://www.pricecharting.com/api-documentation
# Covers: retro_games, retro_handhelds (loose/CIB/new/graded prices)
PRICECHARTING_API_KEY=

# -----------------------------------------------------------------------------
# StockX (Sneakers / Designer Collectibles)
# -----------------------------------------------------------------------------
# Apply at https://developer.stockx.com
# Covers: designer_toys, funko, kpop_merch, loungefly
STOCKX_API_KEY=

# -----------------------------------------------------------------------------
# BrickLink (LEGO Marketplace)
# -----------------------------------------------------------------------------
# Register at https://www.bricklink.com/v3/api.page
# OAuth 1.0a — requires all 4 credentials
BRICKLINK_CONSUMER_KEY=
BRICKLINK_CONSUMER_SECRET=
BRICKLINK_TOKEN=
BRICKLINK_TOKEN_SECRET=

# -----------------------------------------------------------------------------
# Yahoo Auctions JP (via Buyee proxy)
# -----------------------------------------------------------------------------
# No API key needed — uses Buyee web search. Set to true to enable.
# Covers: bandai_premium, jp_event, ghibli, anime_figures, gunpla, vtuber
YAHOO_AUCTIONS_ENABLED=false

# PostHog product analytics. The SDK (posthog-react-native) is installed and
# wired at app/_layout.tsx:140, but initAnalytics() no-ops on an empty key —
# leaving this blank silently disables ALL 33 track() events app-wide.
# Get it from PostHog -> Project Settings -> Project API Key (phc_...).
EXPO_PUBLIC_POSTHOG_KEY=
