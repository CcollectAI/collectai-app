{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "app/_layout.tsx",
    "app/+not-found.tsx",
    "app/(tabs)/**/*.ts",
    "app/(tabs)/**/*.tsx",
    "src/ui/typography.ts",
    "src/ui/usePortfolioWatchlist.ts",
    "src/state/watchlistStore.ts",
    "src/store/collectionStore.ts",
    "src/hooks/useAppTheme.ts",
    "src/components/CategoryPill.tsx",
    "src/components/AddQuickScanLayoutPro.tsx",
    "src/components/AddImportCard.tsx",
    "src/data/events.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".expo",
    "app/_shelf/**",
    "src/screens/**",
    "src/app/**",
    "src/services/**",
    "src/analytics/**",
    "src/export/**",
    "src/settings/**",
    "src/utils/**",
    "src/components/ui/**",
    "types/**",
    "**/*.disabled*",
    "**/*.broken*",
    "**/*.pre_*"
  ]
}
