{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "jsx": "react",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "app/_layout.tsx",
    "app/index.tsx",
    "app/+not-found.tsx",
    "src/**/*",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "app_full_backup",
    "app/debug/**",
    "app/(tabs).bak_routerdebug/**",
    "**/*.bak.*",
    "src/screens/MarketplaceScreen.tsx",
    "src/screens/SignIn.tsx",
    "src/screens/SignUp.tsx",
    "app/lib/busy.ts"
  ]
}
