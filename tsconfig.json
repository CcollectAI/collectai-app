{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "app/_layout.tsx",
    "app/index.tsx",
    "app/+not-found.tsx",
    "src/**/*",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "app_full_backup",
    "app/debug/**",
    "app/(tabs).bak_routerdebug/**",
    "**/*.bak.*",
    "src/screens/Add.tsx",
    "src/screens/AddScreen.tsx",
    "src/screens/Auth.tsx",
    "src/screens/Categories.tsx",
    "src/screens/CategoryDetail.tsx",
    "src/screens/EditItem.tsx",
    "src/screens/Feed.tsx",
    "src/screens/Home.tsx",
    "src/screens/ItemDetail.tsx",
    "src/screens/Items.tsx",
    "src/screens/ListingDetail.tsx",
    "src/screens/Listings.tsx",
    "src/screens/Marketplace.tsx",
    "src/screens/MarketplaceScreen.tsx",
    "src/screens/MyCollection.tsx",
    "src/screens/NewListing.tsx",
    "src/screens/NewPost.tsx",
    "src/screens/PostDetail.tsx",
    "src/screens/SignIn.tsx",
    "src/screens/SignUp.tsx",
    "src/screens/useValuations.ts",
    "app/lib/busy.ts"
  ]
}
