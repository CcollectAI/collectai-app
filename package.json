{
  "name": "collectorsapp",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --host lan",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:ios:local": "eas build --platform ios --profile store --local --non-interactive --output ./builds/sparrow-ios-local.ipa",
    "build:android:local": "JAVA_HOME=/usr/local/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home ANDROID_HOME=/usr/local/share/android-commandlinetools ANDROID_SDK_ROOT=/usr/local/share/android-commandlinetools PATH=\"/usr/local/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home/bin:/usr/local/share/android-commandlinetools/platform-tools:/usr/local/share/android-commandlinetools/cmdline-tools/latest/bin:$PATH\" eas build --platform android --profile store --local --non-interactive --output ./builds/sparrow-android-local.aab",
    "submit:ios": "eas submit --platform ios --profile store --path ./builds/sparrow-ios-local.ipa",
    "release:ios": "npm run build:ios:local && npm run submit:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "precheck": "node scripts/precheck.mjs",
    "dev": "bash scripts/dev.sh",
    "test": "jest",
    "verify:items-contract": "node scripts/verify_items_contract.mjs",
    "verify:prebuild": "node scripts/check-unbounded-awaits.mjs && node scripts/check-dead-nav.mjs && node scripts/check-tab-bar-inset.mjs && node scripts/check-constraint-drift.mjs && node scripts/check-silent-failures.mjs && node scripts/check-self-cancelling-effects.mjs && node scripts/check-route-param-handoff.mjs && node scripts/check-i18n-parity.mjs && node scripts/check-upsert-targets.mjs && node scripts/check-billing-limits-parity.mjs && node scripts/check-archived-filter.mjs && node scripts/check-search-category-ids.mjs && node scripts/check-item-value-source.mjs && tsc --noEmit && jest __tests__/lib/supabaseTimeout.test.ts __tests__/lib/loggerRetention.test.ts __tests__/data/screenItem.test.ts __tests__/data/itemsProviderPurchase.test.ts __tests__/data/personalizedInsights.test.ts __tests__/data/marketplaceSchema.test.ts __tests__/lib/ids.test.ts __tests__/hooks/usePaginatedList.test.ts __tests__/hooks/useSlowLoad.test.ts __tests__/components/ItemsListItem.test.tsx __tests__/components/marketMovers.test.ts __tests__/screens/categoryLabel.test.ts __tests__/screens/leaderboardRow.test.ts && node scripts/verify_items_contract.mjs",
    "i18n:check": "node scripts/check-i18n-strings.mjs",
    "i18n:check:quiet": "node scripts/check-i18n-strings.mjs --quiet",
    "bundle-size": "node scripts/bundle-size.mjs",
    "bundle-size:update": "node scripts/bundle-size.mjs --update",
    "postinstall": "node scripts/postinstall-fixes.js",
    "test:web:referral": "node scripts/web-tests/referral.test.js",
    "audit:drift": "python3 server/scripts/audit_column_drift.py --columns scripts/db_columns.json --scan-only > /tmp/coldrift_refs.json && scp -q /tmp/coldrift_refs.json collectai:/opt/collectors/server/scripts/coldrift_refs.json && ssh collectai 'cd /opt/collectors/server && set -a && . /opt/collectors/.env && set +a && /opt/collectors/.venv/bin/python scripts/audit_column_drift.py --refs scripts/coldrift_refs.json'",
    "audit:drift:refresh": "ssh collectai 'cd /opt/collectors/server && set -a && . /opt/collectors/.env && set +a && /opt/collectors/.venv/bin/python scripts/audit_column_drift.py --dump-columns' > scripts/db_columns.json && npm run audit:drift",
    "verify:unbounded": "node scripts/check-unbounded-awaits.mjs",
    "verify:silent": "node scripts/check-silent-failures.mjs",
    "audit:all": "node scripts/audit_all.mjs",
    "verify:nav": "node scripts/check-dead-nav.mjs",
    "check:tab-inset": "node scripts/check-tab-bar-inset.mjs",
    "verify:constraints": "node scripts/check-constraint-drift.mjs",
    "verify:upserts": "node scripts/check-upsert-targets.mjs",
    "verify:billing-limits": "node scripts/check-billing-limits-parity.mjs",
    "preflight:android": "node scripts/preflight_android.mjs",
    "build:android:apk": "JAVA_HOME=/usr/local/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home ANDROID_HOME=/usr/local/share/android-commandlinetools ANDROID_SDK_ROOT=/usr/local/share/android-commandlinetools PATH=\"/usr/local/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home/bin:/usr/local/share/android-commandlinetools/platform-tools:/usr/local/share/android-commandlinetools/cmdline-tools/latest/bin:$PATH\" eas build --platform android --profile android-apk --local --non-interactive --output ./builds/sparrow-android-apk.apk",
    "check:back": "node scripts/check-unguarded-back.mjs",
    "check:numbers": "node scripts/check-locale-number-parsing.mjs",
    "check:effects": "node scripts/check-self-cancelling-effects.mjs",
    "check:params": "node scripts/check-route-param-handoff.mjs",
    "i18n:parity": "node scripts/check-i18n-parity.mjs",
    "check:archived": "node scripts/check-archived-filter.mjs",
    "check:search-categories": "node scripts/check-search-category-ids.mjs",
    "check:item-values": "node scripts/check-item-value-source.mjs",
    "check:serialization": "node scripts/check-duck-typed-serialization.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/roboto": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "@sentry/react-native": "~7.2.0",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.86.0",
    "base-64": "^1.0.0",
    "expo": "~54.0.33",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.10",
    "expo-blur": "~15.0.8",
    "expo-calendar": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.12",
    "expo-crypto": "~15.0.8",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-localization": "~17.0.8",
    "expo-location": "~19.0.8",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "i18next": "^26.0.4",
    "lucide-react-native": "^0.544.0",
    "posthog-react-native": "^4.37.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.2",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-purchases": "^10.1.0",
    "react-native-purchases-ui": "^10.1.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/schema-utils": "^0.1.7",
    "@testing-library/react-native": "^13.3.3",
    "@types/base-64": "^1.0.2",
    "@types/jest": "^29.5.14",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-axe": "^10.0.0",
    "jest-expo": "~54.0.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "globalSetup": "./jest.globalSetup.js",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|@shopify/flash-list|lucide-react-native|react-native-svg)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFilesAfterEnv": [
      "./__tests__/setup.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/.claude/",
      "<rootDir>/__tests__/setup.ts",
      "<rootDir>/__tests__/a11y/helpers.ts",
      "<rootDir>/scripts/web-tests/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/"
    ]
  },
  "private": true
}
