{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ItemsSummaryV1",
  "type": "object",
  "required": ["user_id","count","total_value","avg_value","top"],
  "properties": {
    "user_id":{"type":"string"},
    "count":{"type":"integer"},
    "total_value":{"type":"number"},
    "avg_value":{"type":"number"},
    "top":{
      "type":"array",
      "items":{"type":"object","properties":{
        "id":{"type":"string"},
        "nk":{"type":"string"},
        "est_value":{"type":["number","null"]}
      }}
    }
  }
}
