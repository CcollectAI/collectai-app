APP_ENV=dev
PORT=8080

# Auth
REQUIRE_JWT=false
JWT_AUDIENCE=authenticated
JWT_ISSUER=https://<YOUR-SUPABASE-PROJECT>.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://<YOUR-SUPABASE-PROJECT>.supabase.co/auth/v1/keys

# Redis
REDIS_URL=redis://localhost:6379/0
FASTPASS_RPM=60
FASTPASS_BURST=60

# Guide cache TTL
GUIDE_TTL_SECONDS=600
AUTH_ALLOW_ANY_BEARER=true
DB_ENABLED=true
DATABASE_URL=postgresql://collect:collect@127.0.0.1:5432/collectdb
READYZ_REQUIRE_DB=true
PERSIST_PREDICTIONS_DB=true
ITEMS_DEFAULT_SORT=value_desc
AUTH_PROTECT_ROUTES=false
CORS_ENABLED=false
CORS_ORIGINS=http://localhost:3000
AUTH_ADMIN_KEY=devkey123
