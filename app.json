{
  "expo": {
    "name": "CollectAI",
    "slug": "collectai",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "scheme": "collectai",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#81D8D0"
    },
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-router",
        {
          "root": "./app"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-sqlite",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "CollectAI needs camera access to scan barcodes and photograph collectibles."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "CollectAI needs access to your calendar to add collection events and drops."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#81D8D0"
        }
      ],
      "expo-apple-authentication"
    ],
    "notification": {
      "iosDisplayInForeground": true,
      "color": "#81D8D0"
    },
    "ios": {
      "bundleIdentifier": "com.collectai.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:collectai.app",
        "applinks:www.collectai.app"
      ],
      "infoPlist": {
        "NSCalendarsUsageDescription": "CollectAI needs access to your calendar to add collection events, drops, and meetups.",
        "NSRemindersUsageDescription": "CollectAI needs access to reminders to notify you about upcoming events.",
        "NSCameraUsageDescription": "CollectAI needs camera access to scan barcodes and photograph collectibles."
      }
    },
    "android": {
      "package": "com.collectai.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#81D8D0"
      },
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "collectai.app",
              "pathPrefix": "/item"
            },
            {
              "scheme": "https",
              "host": "collectai.app",
              "pathPrefix": "/events"
            },
            {
              "scheme": "https",
              "host": "collectai.app",
              "pathPrefix": "/categories"
            },
            {
              "scheme": "https",
              "host": "collectai.app",
              "pathPrefix": "/purchase"
            },
            {
              "scheme": "https",
              "host": "collectai.app",
              "pathPrefix": "/users"
            },
            {
              "scheme": "https",
              "host": "www.collectai.app",
              "pathPrefix": "/item"
            },
            {
              "scheme": "https",
              "host": "www.collectai.app",
              "pathPrefix": "/events"
            },
            {
              "scheme": "https",
              "host": "www.collectai.app",
              "pathPrefix": "/categories"
            },
            {
              "scheme": "https",
              "host": "www.collectai.app",
              "pathPrefix": "/purchase"
            },
            {
              "scheme": "https",
              "host": "www.collectai.app",
              "pathPrefix": "/users"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
