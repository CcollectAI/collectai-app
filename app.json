{
  "expo": {
    "name": "CollectorsApp",
    "slug": "collectors-app",
    "scheme": "collectors",
    "jsEngine": "hermes",
    "platforms": ["ios", "android", "web"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
