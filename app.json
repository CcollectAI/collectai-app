{
  "expo": {
    "name": "collectorsapp",
    "slug": "collectorsapp",
    "scheme": "collectai",
    "plugins": [
      [
        "expo-router",
        {
          "root": "./app"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-sqlite",
      "expo-web-browser",
      [
        "expo-calendar",
        {
          "calendarPermission": "CollectAI needs access to your calendar to add collection events and drops."
        }
      ],
"expo-notifications"
    ],
    "ios": {
      "bundleIdentifier": "com.collectai.app",
      "associatedDomains": [
        "applinks:collectai.app",
        "applinks:www.collectai.app"
      ],
      "infoPlist": {
        "NSCalendarsUsageDescription": "CollectAI needs access to your calendar to add collection events, drops, and meetups.",
        "NSRemindersUsageDescription": "CollectAI needs access to reminders to notify you about upcoming events."
      }
    },
    "android": {
      "package": "com.collectai.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "collectai.app",
              "pathPrefix": "/item"
            },
            {
              "scheme": "https",
              "host": "collectai.app",
              "pathPrefix": "/events"
            },
            {
              "scheme": "https",
              "host": "www.collectai.app",
              "pathPrefix": "/item"
            },
            {
              "scheme": "https",
              "host": "www.collectai.app",
              "pathPrefix": "/events"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
