{
  "expo": {
    "name": "Atlantis",
    "slug": "collectai",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "scheme": "collectai",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#81D8D0"
    },
    "userInterfaceStyle": "automatic",
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/YOUR_PROJECT_ID",
      "checkAutomatically": "ON_LOAD"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./app"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-sqlite",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "CollectAI needs camera access to scan and photograph your collectibles."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "CollectAI needs access to your calendar to add collection events and drops."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#81D8D0"
        }
      ],
      "expo-apple-authentication",
      "@sentry/react-native"
    ],
    "notification": {
      "iosDisplayInForeground": true,
      "color": "#81D8D0"
    },
    "ios": {
      "bundleIdentifier": "com.collectai.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:collectai.app",
        "applinks:www.collectai.app"
      ],
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          }
        ],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhotos",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePreciseLocation",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeProductInteraction",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAnalytics"]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeCrashData",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePaymentInfo",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          }
        ],
        "NSPrivacyTracking": false
      },
      "infoPlist": {
        "NSCalendarsUsageDescription": "CollectAI needs access to your calendar to add collection events, drops, and meetups.",
        "NSRemindersUsageDescription": "CollectAI needs access to reminders to notify you about upcoming events.",
        "NSCameraUsageDescription": "CollectAI needs camera access to scan and photograph your collectibles.",
        "NSLocationWhenInUseUsageDescription": "CollectAI needs your location to find nearby collector events and meetups.",
        "NSPhotoLibraryUsageDescription": "CollectAI needs access to your photo library to add item photos and analyze screenshots.",
        "NSUserTrackingUsageDescription": "CollectAI uses anonymous analytics to improve the app experience. No personal data is shared with advertisers."
      }
    },
    "android": {
      "package": "com.collectai.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#81D8D0"
      },
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "collectai.app",
              "pathPrefix": "/item"
            },
            {
              "scheme": "https",
              "host": "collectai.app",
              "pathPrefix": "/events"
            },
            {
              "scheme": "https",
              "host": "collectai.app",
              "pathPrefix": "/categories"
            },
            {
              "scheme": "https",
              "host": "collectai.app",
              "pathPrefix": "/purchase"
            },
            {
              "scheme": "https",
              "host": "collectai.app",
              "pathPrefix": "/users"
            },
            {
              "scheme": "https",
              "host": "www.collectai.app",
              "pathPrefix": "/item"
            },
            {
              "scheme": "https",
              "host": "www.collectai.app",
              "pathPrefix": "/events"
            },
            {
              "scheme": "https",
              "host": "www.collectai.app",
              "pathPrefix": "/categories"
            },
            {
              "scheme": "https",
              "host": "www.collectai.app",
              "pathPrefix": "/purchase"
            },
            {
              "scheme": "https",
              "host": "www.collectai.app",
              "pathPrefix": "/users"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
