{
  "expo": {
    "name": "Sparrow Collect",
    "slug": "sparrowcollect",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "scheme": "sparrow",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#81D8D0"
    },
    "userInterfaceStyle": "automatic",
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/28c7e9b0-8aa2-4fc7-8080-32bda9bdf282",
      "checkAutomatically": "ON_LOAD"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./app"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-sqlite",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Sparrow needs camera access to scan and photograph your collectibles."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Sparrow needs access to your calendar to add collection events and drops."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#81D8D0"
        }
      ],
      "expo-apple-authentication",
      "@sentry/react-native",
      "expo-localization"
    ],
    "notification": {
      "iosDisplayInForeground": true,
      "color": "#81D8D0"
    },
    "ios": {
      "bundleIdentifier": "io.sparrowcollect.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:sparrowcollect.com",
        "applinks:www.sparrowcollect.com"
      ],
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeName",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeUserID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhotos",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeCoarseLocation",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeProductInteraction",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAnalytics"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeCrashData",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePerformanceData",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePurchaseHistory",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ],
        "NSPrivacyTracking": false
      },
      "infoPlist": {
        "NSCalendarsUsageDescription": "Sparrow needs access to your calendar to add collection events, drops, and meetups.",
        "NSRemindersUsageDescription": "Sparrow needs access to reminders to notify you about upcoming events.",
        "NSCameraUsageDescription": "Sparrow needs camera access to scan and photograph your collectibles.",
        "NSLocationWhenInUseUsageDescription": "Sparrow needs your location to find nearby collector events and meetups.",
        "NSPhotoLibraryUsageDescription": "Sparrow needs access to your photo library to add item photos and analyze screenshots.",
        "NSUserTrackingUsageDescription": "Sparrow uses anonymous analytics to improve the app experience. No personal data is shared with advertisers."
      }
    },
    "android": {
      "package": "io.sparrowcollect.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#81D8D0"
      },
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "sparrowcollect.com",
              "pathPrefix": "/item"
            },
            {
              "scheme": "https",
              "host": "sparrowcollect.com",
              "pathPrefix": "/events"
            },
            {
              "scheme": "https",
              "host": "sparrowcollect.com",
              "pathPrefix": "/categories"
            },
            {
              "scheme": "https",
              "host": "sparrowcollect.com",
              "pathPrefix": "/purchase"
            },
            {
              "scheme": "https",
              "host": "sparrowcollect.com",
              "pathPrefix": "/users"
            },
            {
              "scheme": "https",
              "host": "www.sparrowcollect.com",
              "pathPrefix": "/item"
            },
            {
              "scheme": "https",
              "host": "www.sparrowcollect.com",
              "pathPrefix": "/events"
            },
            {
              "scheme": "https",
              "host": "www.sparrowcollect.com",
              "pathPrefix": "/categories"
            },
            {
              "scheme": "https",
              "host": "www.sparrowcollect.com",
              "pathPrefix": "/purchase"
            },
            {
              "scheme": "https",
              "host": "www.sparrowcollect.com",
              "pathPrefix": "/users"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "root": "./app"
      },
      "eas": {
        "projectId": "28c7e9b0-8aa2-4fc7-8080-32bda9bdf282"
      }
    },
    "owner": "collectai"
  }
}
