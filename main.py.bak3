# --- Liveness & Readiness ---
@app.get("/livez")
async def livez():
    return {"ok": True}

async def _db_ready() -> bool:
    if os.getenv("DB_ENABLED","").lower() not in {"1","true","yes"}:
        return True
    try:
        from app.db.pool import get_pool
        pool = await get_pool()
        if not pool:
            return False
        # Try a no-op query if asyncpg pool
        try:
            async with pool.acquire() as conn:
                await conn.execute("select 1;")
            return True
        except Exception:
            return False
    except Exception:
        return False

@app.get("/readyz")
async def readyz():
    ok_db = await _db_ready()
    ok_metrics = metrics_server_running()
    status_code = 200 if (ok_db and ok_metrics) else 503
    return fastapi.responses.JSONResponse(
        {"db": ok_db, "metrics": ok_metrics, "ready": (ok_db and ok_metrics)},
        status_code=status_code,
    )
# --- END ---

