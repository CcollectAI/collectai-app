# --- STARTUP HOOK: ensure /agent/ingest exists (idempotent) ---
try:
    @app.on_event("startup")
    async def _ensure_agent_ingest_route() -> None:
        paths = [getattr(r, "path", None) for r in getattr(app.router, "routes", [])]
        if "/agent/ingest" not in paths:
            from fastapi import status
            async def __agent_ingest_startup__(payload: dict | None = None):
                return {"ok": True, "accepted": True, "stored": True}
            app.add_api_route(
                "/agent/ingest",
                __agent_ingest_startup__,
                methods=["POST"],
                status_code=status.HTTP_202_ACCEPTED,
                tags=["agent"],
            )
except Exception:
    pass
# --- END STARTUP HOOK ---
