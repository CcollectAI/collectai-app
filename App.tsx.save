import { useEffect, useState } from 'react';
import { Pressable } from 'react-native';
import { NavigationContainer } from '@react-navigation/native';
import { createBottomTabNavigator } from '@react-navigation/bottom-tabs';
import { createNativeStackNavigator } from '@react-navigation/native-stack';
import { Ionicons } from '@expo/vector-icons';
import { supabase } from './src/lib/supabase';
import Marketplace from './src/screens/Marketplace';
import NewListing from './src/screens/NewListing';
import ListingDetail from './src/screens/ListingDetail';
import Auth from './src/screens/Auth';
import Home from './src/screens/Home';
import Feed from './src/screens/Feed';
import Items from './src/screens/Items';
import Add from './src/screens/Add';
import NewPost from './src/screens/NewPost';
import Settings from './src/screens/Settings';
import ItemDetail from './src/screens/ItemDetail';
import EditItem from './src/screens/EditItem';
import PostDetail from './src/screens/PostDetail';
import TabIcon from './src/components/TabIcon';
import { colors } from './src/theme/tokens';

const Tab = createBottomTabNavigator();
const Stack = createNativeStackNavigator();

function Tabs({ navigation }: any){
  const headerCommon = {
    headerShadowVisible: false as const,
    headerRight: () => (
      <Pressable onPress={() => navigation.navigate('Settings')} style={{ paddingHorizontal: 12 }}>
        <Ionicons name="construct-outline" size={22} color={colors.accentStrong} />
      </Pressable>
    ),
  };

  return (
    <Tab.Navigator
      screenOptions={{
        headerShown: true,
        tabBarShowLabel: false,
        tabBarStyle: { height: 64, paddingBottom: 10, paddingTop: 6, borderTopWidth: 1, borderTopColor: '#E2E8F0' },
        tabBarItemStyle: { alignItems: 'center', justifyContent: 'center' },
      }}
    >
      <Tab.Screen
        name="Home"
        component={Home}
        options={{
          ...headerCommon,
          tabBarIcon: ({ focused }) => <TabIcon name="home-outline" focused={focused} label="Home" />,
        }}
      />
      <Tab.Screen
        name="Feed"
        component={Feed}
        options={{
          ...headerCommon,
          tabBarIcon: ({ focused }) => <TabIcon name="chatbubbles-outline" focused={focused} label="Feed" />,
        }}
      />
      <Tab.Screen
        name="Items"
        component={Items}
        options={{
          ...headerCommon,
          tabBarIcon: ({ focused }) => <TabIcon name="grid-outline" focused={focused} label="Items" />,
        }}
      />
      <Tab.Screen
        name="Add"
        component={Add}
        options={{
          ...headerCommon,
          tabBarIcon: ({ focused }) => <TabIcon name="add-circle-outline" focused={focused} label="Add" />,
        }}
      />
    </Tab.Navigator>
  );
}

export default function App(){
  const [session, setSession] = useState<any>(null);

  useEffect(() => {
    supabase.auth.getSession().then(({ data }) => setSession(data.session));
    const { data: sub } = supabase.auth.onAuthStateChange((_e, s) => setSession(s));
    return () => sub.subscription.unsubscribe();
  }, []);

  if (!session) return <Auth />;

  return (
    <NavigationContainer>
      <Stack.Navigator>
        <Stack.Screen name="Root" component={Tabs} options={{ headerShown: false }} />
        <Stack.Screen name="ItemDetail" component={ItemDetail} options={{ title: 'Item' }} />
        <Stack.Screen name="NewPost" component={NewPost} options={{ title: 'New Post' }} />
        <Stack.Screen name="Settings" component={Settings} options={{ title: 'Settings' }} />
        <Stack.Screen name="PostDetail" component={PostDetail} options={{ title: 'Post' }} />
        <Stack.Screen name="EditItem" component={EditItem} options={{ title: 'Edit Item' }} />
      </Stack.Navigator>
    </NavigationContainer>
  );
}
