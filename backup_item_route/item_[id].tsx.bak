  },
  tierPillText: {
    fontSize: 12,
    fontWeight: "600",
    color: "#19A7AE",
    marginLeft: 4,
  },
  subText: {
    fontSize: 13,
    color: "#647589",
  },
  plRow: {
    flexDirection: "row",
    marginTop: 8,
  },
  plCol: {
    flex: 1,
  },
  plLabel: {
    fontSize: 12,
    color: "#647589",
  },
  plValue: {
    fontSize: 16,
    fontWeight: "600",
    marginTop: 2,
    color: "#0C2233",
  },
  actionsRow: {
    flexDirection: "row",
    marginBottom: 12,
    gap: 8,
  },
  actionButton: {
    flex: 1,
    flexDirection: "row",
    alignItems: "center",
    borderRadius: 999,
    backgroundColor: "#FFFFFF",
    borderWidth: 1,
    borderColor: "#D6E4EC",
    paddingVertical: 10,
    paddingHorizontal: 12,
  },
  actionText: {
    fontSize: 13,
    fontWeight: "600",
    color: "#0C2233",
    marginLeft: 6,
  },
  notesText: {
    fontSize: 14,
    color: "#0C2233",
    marginTop: 6,
  },
  notFoundContainer: {
    flex: 1,
    alignItems: "center",
    justifyContent: "center",
    paddingHorizontal: 24,
  },
  notFoundTitle: {
    fontSize: 20,
    fontWeight: "700",
    color: "#0C2233",
    marginBottom: 4,
  },
  notFoundText: {
    fontSize: 14,
    color: "#647589",
    textAlign: "center",
    marginBottom: 12,
  },
  backButton: {
    flexDirection: "row",
    alignItems: "center",
    borderRadius: 999,
    backgroundColor: "#19A7AE",
    paddingHorizontal: 16,
    paddingVertical: 8,
  },
  backButtonText: {
    color: "#FFFFFF",
    fontSize: 14,
    fontWeight: "600",
    marginLeft: 6,
  },
});

export default ItemDetailScreen;
