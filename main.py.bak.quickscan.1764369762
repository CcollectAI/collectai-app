from app.features import marketplace_trust_router
from app.features import provenance_router
from app.features import trends_and_deepdive_router
from app.features import alerts_feature_router
import os\nimport httpx\nfrom typing import Dict\nfrom app.routers.vision_commit import router as vision_commit_router\nfrom app.routers.vision_predict_log import router as vision_predict_log_router\nfrom fastapi import FastAPI, Depends, Header, HTTPException, UploadFile, File\nfrom app.routers import portfolio_trends_patch\nfrom app.routers import items_trends_patch\nfrom app.routers import categories_deepdive\nfrom app.routers import alerts_advanced\nfrom app.routers import provenance\nfrom app.routers import alerts_runner\nfrom app.routers import item_insights\nfrom app.routers import watchlist_insights\nfrom app.routers import marketplace_trust\nfrom app.routers import screenshot_intel\nfrom app.routers import quickscan_flow\nfrom typing import Dict, List\nfrom pydantic import BaseModel\nfrom app.middleware_stack import install_middlewares\nfrom app.db import connect_pool, close_pool, db_configured\nfrom app.metrics import metrics_middleware, ensure_metrics_once\nfrom app.logging_mw import logging_middleware\nfrom app.limit_body import limit_body_middleware\nfrom app.rate_limit import rate_limit_middleware\nfrom app.routes.agent import router as agent_router\nfrom app.routes.spool import router as ops_router\nfrom app.routes.spool_ui import router as spool_ui_router\nfrom app.routes.webhook import router as webhook_router\nfrom app.routes.vision_debug import router as vision_debug_router\nfrom app.routes.vision_predict import router as vision_predict_router\nfrom app.routes.vision_ops import router as vision_ops_router\nfrom app.routes.vision_ingest import router as vision_ingest_router\nfrom app.routes.vision_search import router as vision_search_router\nfrom app.routes.spool_ops import router as spool_ops_router\nfrom app.routes.manifests import router as manifests_router\nfrom app.routes.ops import router as ops_router\nfrom app.routes.marketplace import router as marketplace_router\n\napp = FastAPI(title="Collectors Merge Service", version=os.getenv("SERVICE_VERSION","0.1.0"))\napp.include_router(items_trends_patch.router)\napp.include_router(alerts_advanced.router)\napp.include_router(categories_deepdive.router)\napp.include_router(portfolio_trends_patch.router)\napp.include_router(item_insights.router)\napp.include_router(alerts_runner.router)\napp.include_router(provenance.router)\nAPI_SHARED_SECRET = os.environ.get("API_SHARED_SECRET")\nSIGNALS_BASE_URL = "http://127.0.0.1:8082"\n\n\nasync def require_api_key(x_api_key: str = Header(..., alias="X-API-Key")):\n    if not API_SHARED_SECRET:\n        raise HTTPException(status_code=500, detail="API key not configured")\n    if x_api_key != API_SHARED_SECRET:\n        raise HTTPException(status_code=401, detail="Invalid API key")\n    return True\n\n\n@app.get("/debug-ping")\nasync def debug_ping():\n    return {"ok": True}\n\n\n@app.get("/portfolio/overview")\nasync def portfolio_overview(_: bool = Depends(require_api_key)):\n    async with httpx.AsyncClient() as client:\n        r = await client.get(\n            f"{SIGNALS_BASE_URL}/portfolio/overview",\n            headers={"X-API-Key": API_SHARED_SECRET},\n            timeout=10.0,\n        )\n    r.raise_for_status()\n    return r.json()\n\n\n@app.get("/portfolio/items")\nasync def portfolio_items(_: bool = Depends(require_api_key)):\n    async with httpx.AsyncClient() as client:\n        r = await client.get(\n            f"{SIGNALS_BASE_URL}/portfolio/items",\n            headers={"X-API-Key": API_SHARED_SECRET},\n            timeout=10.0,\n        )\n    r.raise_for_status()\n    return r.json()\n\n\n@app.get("/portfolio/timeseries")\n\n@app.get("/portfolio/history")\nasync def portfolio_history(_: bool = Depends(require_api_key)):\n    """\n    Mock portfolio history for the Portfolio screen chart.\n    30-day series + summary stats.\n    """\n    import random\n    from datetime import datetime, timedelta\n\n    today = datetime.utcnow().date()\n    values = []\n    base_value = 1240.0  # mock portfolio total\n\n    for i in range(30):\n        day = today - timedelta(days=i)\n        val = base_value + random.uniform(-90, 90)\n        values.append({"date": str(day), "value": round(val, 2)})\n\n    values = list(reversed(values))\n\n    vals = [v["value"] for v in values]\n    return {\n        "series": values,\n        "summary": {\n            "min": min(vals),\n            "max": max(vals),\n            "avg": sum(vals) / len(vals),\n            "change_1d": vals[-1] - vals[-2],\n            "change_7d": vals[-1] - vals[-8],\n        },\n    }\n\nasync def portfolio_timeseries(_: bool = Depends(require_api_key)):\n    async with httpx.AsyncClient() as client:\n        r = await client.get(\n            f"{SIGNALS_BASE_URL}/portfolio/timeseries",\n            headers={"X-API-Key": API_SHARED_SECRET},\n            timeout=10.0,\n        )\n    r.raise_for_status()\n    return r.json()\n\n@app.post("/screenshot/analyze")\nasync def analyze_screenshot(file: UploadFile = File(...)) -> Dict:\n    """\n    Phase 1: Mock screenshot extraction.\n    This will later plug into the multimodal model.\n    """\n    return {\n        "mock": True,\n        "detected_items": ["pikachu-card", "funko-123"],\n        "confidence": 0.82,\n        "note": "Replace with real OCR + vision model later",\n    }\n\n# --- Screenshot → Watchlist (mock pipeline) ---\n\n@app.post("/screenshot/to-watchlist")\nasync def screenshot_to_watchlist(user_id: str = "demo-user", file: UploadFile = File(...)):\n    # 1. Call internal analyzer\n    from fastapi import UploadFile\n\n    # Read content for internal mock call\n    content = await file.read()\n\n    # Reuse the existing mock analyzer\n    analysis = {\n        "mock": True,\n        "detected_items": ["pikachu-card", "funko-123"],\n        "confidence": 0.82,\n    }\n\n    added = []\n    for item in analysis["detected_items"]:\n        wl = WatchlistItem(\n            id=f"wl-{len(_MOCK_WATCHLIST)+1}",\n            user_id=user_id,\n            item_id=item,\n        )\n        _MOCK_WATCHLIST.append(wl)\n        added.append(wl)\n\n    return {\n        "analysis": analysis,\n        "added": added,\n    }\n\n# --- Watchlist models & endpoints (mock-friendly) ---\n\nclass WatchlistItem(BaseModel):\n    id: str\n    user_id: str\n    item_id: str\n\n\n# Simple in-memory mock store for now (resets on restart)\n_MOCK_WATCHLIST: List[WatchlistItem] = []\n\n\n@app.get("/watchlist", response_model=List[WatchlistItem])\nasync def get_watchlist(user_id: str = "demo-user"):\n    # Later: replace with real DB query\n    return [w for w in _MOCK_WATCHLIST if w.user_id == user_id]\n\n\nclass WatchlistCreate(BaseModel):\n    user_id: str\n    item_id: str\n\n\n@app.post("/watchlist", response_model=WatchlistItem)\nasync def add_to_watchlist(body: WatchlistCreate):\n    # Later: DB insert instead of in-memory\n    item = WatchlistItem(\n        id=f"wl-{len(_MOCK_WATCHLIST)+1}",\n        user_id=body.user_id,\n        item_id=body.item_id,\n    )\n    _MOCK_WATCHLIST.append(item)\n    return item\n\n# --- Alerts (mock backend) ---\n\nclass Alert(BaseModel):\n    id: str\n    user_id: str\n    item_id: str\n    alert_type: str\n    threshold_value: float | None = None\n    active: bool = True\n\n_MOCK_ALERTS: List[Alert] = []\n\n@app.get("/alerts", response_model=List[Alert])\nasync def get_alerts(user_id: str = "demo-user"):\n    return [a for a in _MOCK_ALERTS if a.user_id == user_id]\n\nclass AlertCreate(BaseModel):\n    user_id: str\n    item_id: str\n    alert_type: str\n    threshold_value: float | None = None\n\n@app.post("/alerts", response_model=Alert)\nasync def create_alert(body: AlertCreate):\n    alert = Alert(\n        id=f"al-{len(_MOCK_ALERTS)+1}",\n        user_id=body.user_id,\n        item_id=body.item_id,\n        alert_type=body.alert_type,\n        threshold_value=body.threshold_value,\n        active=True,\n    )\n    _MOCK_ALERTS.append(alert)\n    return alert\n\n# Basic demo runner simulating a cron check\n@app.post("/alerts/run-demo")\nasync def run_alerts_demo(user_id: str = "demo-user"):\n    fired = []\n    for a in _MOCK_ALERTS:\n        if a.active and a.threshold_value is not None:\n            # mock: assume item always "drops" below threshold\n            fired.append({\n                "alert_id": a.id,\n                "item_id": a.item_id,\n                "trigger": f"Mock threshold hit: {a.threshold_value}"\n            })\n    return {"fired": fired}\n\n# --- Item Value History (mock timeseries) ---\n\nfrom datetime import datetime, timedelta\nimport random\n\n@app.get("/items/{item_id}/history")\n@app.get("/items/{item_id}/history/extended")\nasync def get_item_history_extended(item_id: str):\n    """\n    Extended variant: returns history + basic stats.\n    """\n    import random\n    from datetime import datetime, timedelta\n\n    today = datetime.utcnow().date()\n    days = [today - timedelta(days=i) for i in range(30)]\n\n    values = [round(100 + random.random()*40, 2) for _ in days]\n    history = [{"date": d.isoformat(), "value": v} for d, v in zip(days, values)]\n\n    return {\n        "history": history,\n        "stats": {\n            "min": min(values),\n            "max": max(values),\n            "avg": sum(values) / len(values),\n            "volatility": max(values) - min(values),\n        }\n    }\n\nasync def item_history(item_id: str):\n    """\n    Mock price history for charts.\n    Generates 30 days of random values around 100–150 EUR.\n    """\n    base = 120.0\n    history = []\n    today = datetime.utcnow()\n\n    for i in range(30):\n        day = today - timedelta(days=i)\n        value = base + random.uniform(-15, 15)\n        history.append({\n            "date": day.strftime("%Y-%m-%d"),\n            "value": round(value, 2)\n        })\n\n    # Return oldest → newest\n    history.reverse()\n    return history\n\n# Core middlewares\ninstall_middlewares(app)\napp.middleware("http")(rate_limit_middleware)\napp.middleware("http")(metrics_middleware)\napp.middleware("http")(logging_middleware)\n\n# Routers\napp.include_router(agent_router)\napp.include_router(spool_ui_router)\napp.include_router(webhook_router)\napp.include_router(vision_debug_router)\napp.include_router(vision_predict_router)\napp.include_router(vision_ops_router)\napp.include_router(vision_ingest_router)\napp.include_router(vision_search_router)\napp.include_router(spool_ops_router)\napp.include_router(manifests_router)\napp.include_router(spool_ops_router)\napp.include_router(spool_ui_router)\napp.include_router(vision_commit_router)\napp.include_router(vision_predict_log_router)\napp.include_router(marketplace_router)\napp.include_router(watchlist_insights.router)\napp.include_router(marketplace_trust.router)\napp.include_router(screenshot_intel.router)\napp.include_router(quickscan_flow.router)\n\n\n@app.get("/healthz")\nasync def healthz():\n    return {\n        "ok": True,\n        "db_configured": db_configured(),\n        "db_enabled": os.getenv("DB_ENABLED","true"),\n        "db_optional": os.getenv("DB_OPTIONAL","0"),\n    }\n\n@app.get("/version")\nasync def version():\n    return {"version": os.getenv("SERVICE_VERSION","0.1.0")}\n\n@app.on_event("startup")\nasync def _startup():\n    import os, logging\n    # Offline mode: skip DB connect entirely\n    if os.getenv("DB_ENABLED", "false").lower() in ("0","false","no"):\n        logging.getLogger("uvicorn").info("[startup] DB disabled; skipping pool connect.")\n        return\n    try:\n        from app.db import connect_pool\n        await connect_pool()\n    except Exception as e:\n        # Optional mode: continue even if DB connect fails/missing DSN\n        if os.getenv("DB_OPTIONAL", "0").lower() in ("1","true","yes"):\n            logging.getLogger("uvicorn").warning(f"[startup] DB optional; continuing without pool. Reason: {e}")\n            return\n        raise\n@app.on_event("shutdown")\nasync def _shutdown():\n    await close_pool()\n\n@app.get("/debug-ping")\nasync def debug_ping():\n    return {"ok": True}\n\n# --- Item Detail demo endpoint (no DB required) ---\n\nfrom datetime import datetime\nfrom typing import List, Optional\n\nfrom pydantic import BaseModel\n\n\nclass ItemPredictionBand(BaseModel):\n    low: Optional[float] = None\n    mid: Optional[float] = None\n    high: Optional[float] = None\n    currency: str = "EUR"\n    model_name: Optional[str] = None\n    as_of: Optional[datetime] = None\n\n\nclass ItemSignal(BaseModel):\n    name: str\n    value: str\n    unit: Optional[str] = None\n\n\nclass ItemCategoryMeta(BaseModel):\n    slug: str\n    label: str\n    wave: Optional[str] = None\n    avg_value: Optional[float] = None\n    item_count: Optional[int] = None\n    active: Optional[bool] = None\n\n\nclass ItemDetail(BaseModel):\n    id: str\n    name: str\n    category_slug: str\n    estimated_value: float\n    currency: str = "EUR"\n    change_1d_pct: Optional[float] = None\n\n    prediction: Optional[ItemPredictionBand] = None\n    category_meta: Optional[ItemCategoryMeta] = None\n    signals: List[ItemSignal] = []\n\n    condition_text: Optional[str] = None\n    edition_text: Optional[str] = None\n    series_text: Optional[datetime] = None\n    acquisition_price: Optional[float] = None\n    acquisition_currency: Optional[str] = None\n    acquisition_date: Optional[datetime] = None\n\n\n@app.get("/items/{item_id}/detail", response_model=ItemDetail)\nasync def get_item_detail_demo(item_id: str) -> ItemDetail:\n    """\n    Demo implementation of item detail.\n\n    This does NOT use the database yet. It returns rich demo data\n    so the Expo Item Detail screen can render all sections.\n\n    Later, when DB is enabled, we will replace this with a real\n    query to v_item_detail_full.\n    """\n    demo_name = f"Demo collectible #{item_id[:6]}"\n\n    return ItemDetail(\n        id=item_id,\n        name=demo_name,\n        category_slug="funko",\n        estimated_value=125.0,\n        currency="EUR",\n        change_1d_pct=7.5,\n        prediction=ItemPredictionBand(\n            low=100.0,\n            mid=125.0,\n            high=160.0,\n            currency="EUR",\n            model_name="demo-valuation-model",\n            as_of=datetime.utcnow(),\n        ),\n        category_meta=ItemCategoryMeta(\n            slug="funko",\n            label="Funko Pops",\n            wave="wave1",\n            avg_value=80.0,\n            item_count=42,\n            active=True,\n        ),\n        signals=[\n            ItemSignal(name="Recent sales", value="Up", unit=None),\n            ItemSignal(name="Scarcity", value="High", unit=None),\n            ItemSignal(name="Collector interest", value="Strong", unit=None),\n        ],\n        condition_text="Near mint",\n        edition_text="Special edition",\n        series_text="Wave 1 – Launch",\n        acquisition_price=60.0,\n        acquisition_currency="EUR",\n        acquisition_date=datetime(2024, 1, 15),\n    )\n\n# --- Item Detail demo endpoint (no DB required) ---\n\nfrom datetime import datetime\nfrom typing import List, Optional\n\nfrom pydantic import BaseModel\n\n\nclass ItemPredictionBand(BaseModel):\n    low: Optional[float] = None\n    mid: Optional[float] = None\n    high: Optional[float] = None\n    currency: str = "EUR"\n    model_name: Optional[str] = None\n    as_of: Optional[datetime] = None\n\n\nclass ItemSignal(BaseModel):\n    name: str\n    value: str\n    unit: Optional[str] = None\n\n\nclass ItemCategoryMeta(BaseModel):\n    slug: str\n    label: str\n    wave: Optional[str] = None\n    avg_value: Optional[float] = None\n    item_count: Optional[int] = None\n    active: Optional[bool] = None\n\n\nclass ItemDetail(BaseModel):\n    id: str\n    name: str\n    category_slug: str\n    estimated_value: float\n    currency: str = "EUR"\n    change_1d_pct: Optional[float] = None\n\n    prediction: Optional[ItemPredictionBand] = None\n    category_meta: Optional[ItemCategoryMeta] = None\n    signals: List[ItemSignal] = []\n\n    condition_text: Optional[str] = None\n    edition_text: Optional[str] = None\n    series_text: Optional[str] = None\n    acquisition_price: Optional[float] = None\n    acquisition_currency: Optional[str] = None\n    acquisition_date: Optional[datetime] = None\n\n\n@app.get("/items/{item_id}/detail", response_model=ItemDetail)\nasync def get_item_detail_demo(item_id: str) -> ItemDetail:\n    """\n    Demo implementation of item detail.\n\n    This does NOT use the database yet. It returns rich demo data\n    so the Expo Item Detail screen can render all sections.\n\n    Later, when DB is enabled, we will replace this with a real\n    query to v_item_detail_full.\n    """\n    demo_name = f"Demo collectible #{item_id[:6]}"\n\n    return ItemDetail(\n        id=item_id,\n        name=demo_name,\n        category_slug="funko",\n        estimated_value=125.0,\n        currency="EUR",\n        change_1d_pct=7.5,\n        prediction=ItemPredictionBand(\n            low=100.0,\n            mid=125.0,\n            high=160.0,\n            currency="EUR",\n            model_name="demo-valuation-model",\n            as_of=datetime.utcnow(),\n        ),\n        category_meta=ItemCategoryMeta(\n            slug="funko",\n            label="Funko Pops",\n            wave="wave1",\n            avg_value=80.0,\n            item_count=42,\n            active=True,\n        ),\n        signals=[\n            ItemSignal(name="Recent sales", value="Up", unit=None),\n            ItemSignal(name="Scarcity", value="High", unit=None),\n            ItemSignal(name="Collector interest", value="Strong", unit=None),\n        ],\n        condition_text="Near mint",\n        edition_text="Special edition",\n        series_text="Wave 1 – Launch",\n        acquisition_price=60.0,\n        acquisition_currency="EUR",\n        acquisition_date=datetime(2024, 1, 15),\n    )\n\n# --- Minimal Item Detail demo endpoint (no DB, no models) ---\n\n@app.get("/items/{item_id}/detail")\nasync def get_item_detail_demo_min(item_id: str):\n    from datetime import datetime\n\n    # This must be JSON-serializable, so we convert datetime to ISO string.\n    as_of = datetime.utcnow().isoformat() + "Z"\n\n    return {\n        "id": item_id,\n        "name": f"Demo collectible #{item_id[:6]}",\n        "category_slug": "funko",\n        "estimated_value": 125.0,\n        "currency": "EUR",\n        "change_1d_pct": 7.5,\n        "prediction": {\n            "low": 100.0,\n            "mid": 125.0,\n            "high": 160.0,\n            "currency": "EUR",\n            "model_name": "demo-valuation-model",\n            "as_of": as_of,\n        },\n        "category_meta": {\n            "slug": "funko",\n            "label": "Funko Pops",\n            "wave": "wave1",\n            "avg_value": 80.0,\n            "item_count": 42,\n            "active": True,\n        },\n        "signals": [\n            {"name": "Recent sales", "value": "Up", "unit": None},\n            {"name": "Scarcity", "value": "High", "unit": None},\n            {"name": "Collector interest", "value": "Strong", "unit": None},\n        ],\n        "condition_text": "Near mint",\n        "edition_text": "Special edition",\n        "series_text": "Wave 1 – Launch",\n        "acquisition_price": 60.0,\n        "acquisition_currency": "EUR",\n        "acquisition_date": "2024-01-15T00:00:00Z",\n    }

# Auto-wired alerts router
app.include_router(alerts_feature_router.router)

# Auto-wired trends/deep-dive router
app.include_router(trends_and_deepdive_router.router)

# Auto-wired provenance router
app.include_router(provenance_router.router)

# Auto-wired marketplace trust router
app.include_router(marketplace_trust_router.router)
