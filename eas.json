{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_SUPABASE_MODE": "mock"
      }
    },
    "development-device": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_SUPABASE_MODE": "strict",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "SENTRY_ALLOW_FAILURE": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "production",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_SUPABASE_MODE": "strict",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "SENTRY_ALLOW_FAILURE": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_SUPABASE_MODE": "strict",
        "_comment_beta_unlock": "MUST stay 'false' on any profile that can reach the App Store. The EAS 'production' environment sets EXPO_PUBLIC_BETA_UNLOCK_ALL=true for internal testers; a build profile that does not pin it inherits that true, and BETA_UNLOCK_ALL makes useBillingLimits report every user as 'pro' AND skip RevenueCat entirely (src/hooks/useBillingLimits.ts:102). This profile has a submit config with the same ascAppId as 'store', so it is a shippable path — before 2026-07-27 it would have shipped a build where the paywall did not exist.",
        "EXPO_PUBLIC_BETA_UNLOCK_ALL": "false"
      }
    },
    "store": {
      "extends": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_SUPABASE_MODE": "strict",
        "EXPO_PUBLIC_BETA_UNLOCK_ALL": "false"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "slendebroekmerle@gmail.com",
        "ascAppId": "6767359453",
        "appleTeamId": "3DX8FBF7S6"
      },
      "android": {
        "serviceAccountKeyPath": "./sparrow-play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "store": {
      "ios": {
        "appleId": "slendebroekmerle@gmail.com",
        "ascAppId": "6767359453",
        "appleTeamId": "3DX8FBF7S6"
      },
      "android": {
        "serviceAccountKeyPath": "./sparrow-play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
