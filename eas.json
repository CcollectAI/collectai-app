{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_SUPABASE_MODE": "mock"
      }
    },
    "development-device": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_SUPABASE_MODE": "strict",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "SENTRY_ALLOW_FAILURE": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_SUPABASE_MODE": "strict"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_SUPABASE_MODE": "strict"
      }
    },
    "store": {
      "extends": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_SUPABASE_MODE": "strict",
        "EXPO_PUBLIC_BETA_UNLOCK_ALL": "false"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "slendebroekmerle@gmail.com",
        "ascAppId": "6767359453",
        "appleTeamId": "3DX8FBF7S6"
      },
      "android": {
        "serviceAccountKeyPath": "./sparrow-play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "store": {
      "ios": {
        "appleId": "slendebroekmerle@gmail.com",
        "ascAppId": "6767359453",
        "appleTeamId": "3DX8FBF7S6"
      },
      "android": {
        "serviceAccountKeyPath": "./sparrow-play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
