{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_SUPABASE_MODE": "mock"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_SUPABASE_MODE": "strict"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_SUPABASE_MODE": "strict"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "apple@sparrowcollect.com",
        "ascAppId": "TODO_FILL_AFTER_APP_STORE_CONNECT_RECORD_CREATED",
        "appleTeamId": "TODO_FILL_FROM_DEVELOPER_PORTAL_TOP_RIGHT"
      },
      "android": {
        "serviceAccountKeyPath": "./sparrow-play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
