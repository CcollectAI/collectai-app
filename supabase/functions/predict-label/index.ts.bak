import { serve } from "https://deno.land/std@0.224.0/http/server.ts"
import { z } from "https://esm.sh/zod@3.23.8"
import { createClient } from "https://esm.sh/@supabase/supabase-js@2.46.1"
import { logMetric } from "../_shared/metrics.ts"

const URL = Deno.env.get("SUPABASE_URL")!
const SRK = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
const ANON = Deno.env.get("SUPABASE_ANON_KEY")!
const VERSION = "predict-label:2025-09-21+provenance"

const baseHeaders = { "Accept-Profile": "public", "Content-Profile": "public" }
const admin = createClient(URL, SRK, { db: { schema: "public" }, global: { headers: baseHeaders } })
const pubFor = (req: Request) =>
  createClient(URL, ANON, { db: { schema: "public" }, global: { headers: { ...baseHeaders, Authorization: req.headers.get("Authorization") ?? "" } } })

const Body = z.object({
  session_uuid: z.string().uuid(),
  corrected_title: z.string().min(1),
  corrected_condition: z.string().min(1),
  corrected_price_eur: z.number().nonnegative(),
  image_url: z.string().url().optional()   // <- optional image URL from client
})

serve(async (req) => {
  try {
    if (!(req.headers.get("content-type") || "").includes("application/json"))
      return new Response(JSON.stringify({ error: "Content-Type must be application/json", version: VERSION }), { status: 415 })

    const pub = pubFor(req)
    const { data: u, error: uerr } = await pub.auth.getUser()
    if (uerr) return new Response(JSON.stringify({ error: "Auth getUser failed", details: uerr.message, version: VERSION }), { status: 401 })
    const user_id = u?.user?.id ?? null

    const parsed = Body.safeParse(await req.json())
    if (!parsed.success) return new Response(JSON.stringify({ error: "Invalid payload", issues: parsed.error.issues, version: VERSION }), { status: 400 })

    // Enrich with category if available
    const sess = await admin.from("predict_sessions").select("uuid_id,user_id,category").eq("uuid_id", parsed.data.session_uuid).maybeSingle()
    const category = sess.data?.category ?? null

    // 1) Persist label event
    const ins = await admin.from("label_events").insert([{
      user_id,
      session_uuid: parsed.data.session_uuid,
      corrected_title: parsed.data.corrected_title,
      corrected_condition: parsed.data.corrected_condition,
      corrected_price_eur: parsed.data.corrected_price_eur,
      action: "label"
    }]).select("*").single()
    if (ins.error) return new Response(JSON.stringify({ error: ins.error.message, details: ins.error.details ?? null, version: VERSION }), { status: 400 })

    // 2) Upsert training row
    const payload: any = {
      session_uuid: parsed.data.session_uuid,
      user_id,
      category: category ?? undefined,
      corrected_title: parsed.data.corrected_title,
      corrected_condition: parsed.data.corrected_condition,
      corrected_price_eur: parsed.data.corrected_price_eur,
      title: parsed.data.corrected_title,
      image_url: parsed.data.image_url ?? null,
      source: "edge:predict-label",
      version: VERSION,
      idem_key: `${parsed.data.session_uuid}:label`
    }

    const up = await admin
      .from("training_items")
      .upsert([payload], { onConflict: "session_uuid" })
      .select("session_uuid,user_id,category,title,raw_title,raw_condition,raw_price_eur,corrected_title,corrected_condition,corrected_price_eur,image_url,source,version,created_at,updated_at")
      .eq("session_uuid", parsed.data.session_uuid)
      .maybeSingle()

    const training_error = up.error ?? null
    const training = up.data ?? null

    return new Response(JSON.stringify({
      version: VERSION,
      label: ins.data,
      training,
      training_error
    }), { status: 200 })
  } catch (e) {
    console.error("predict-label unhandled:", e)
    return new Response(JSON.stringify({ error: e instanceof Error ? e.message : String(e), version: VERSION }), { status: 500 })
  }
})
