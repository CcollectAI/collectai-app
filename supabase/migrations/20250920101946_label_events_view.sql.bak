-- Simple view to present label events with session context.
-- Works whether sessions live in public.predict_sessions or predictive_capture.sessions.

create or replace view public.v_label_events as
with sess as (
  select 'public'::text as src, id, uuid_id, user_id, category, created_at
  from public.predict_sessions
  where to_regclass('public.predict_sessions') is not null
  union all
  select 'pc'::text, id, uuid_id, user_id, category, created_at
  from predictive_capture.sessions
  where to_regclass('predictive_capture.sessions') is not null
)
select
  le.id as label_event_id,
  le.created_at as label_created_at,
  le.user_id,
  le.action,
  le.corrected_title,
  le.corrected_condition,
  le.corrected_price_eur,
  le.session_id,
  le.session_uuid,
  s.src as session_src,
  s.category as session_category,
  s.created_at as session_created_at
from public.label_events le
left join sess s
  on (le.session_uuid is not null and s.uuid_id = le.session_uuid)
  or (le.session_uuid is null and le.session_id is not null and s.id = le.session_id);

comment on view public.v_label_events is 'Enriched label_events joined to sessions';

-- Convenience indexes (on base table)
create index if not exists label_events_user_created_idx on public.label_events(user_id, created_at desc);

-- RLS inherits from base tables; for clarity you may add a view policy:
drop policy if exists v_label_events_select_own on public.v_label_events;
create policy v_label_events_select_own
  on public.v_label_events
  for select
  to authenticated
  using (user_id = auth.uid());

-- Nudge PostgREST
do $$ begin perform pg_notify('pgrst','reload schema'); exception when others then null; end $$;
