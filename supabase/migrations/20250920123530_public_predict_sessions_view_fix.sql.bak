do $$
begin
  if to_regclass('predictive_capture.sessions') is null then
    raise exception 'predictive_capture.sessions not found; cannot create public view.';
  end if;

  -- Minimal 1:1 mapping → inherently updatable by Postgres
  create or replace view public.predict_sessions as
  select
    id,
    uuid_id,         -- may be nullable; OK
    user_id,
    category,
    status,
    created_at,
    updated_at
  from predictive_capture.sessions;

  comment on view public.predict_sessions is
    'Updatable view over predictive_capture.sessions so API/functions can use the public schema.';

  -- RLS stays on the base table; service role bypasses RLS, but we still grant privileges on the view.
  grant select, insert, update, delete on public.predict_sessions to service_role;
  grant select on public.predict_sessions to authenticated;

  -- Hard cache nudge for PostgREST so the route becomes available immediately
  perform pg_notify('pgrst','reload schema');
end $$;
