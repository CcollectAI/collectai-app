#!/usr/bin/env python3
import argparse, json, os, sys, time, hashlib
from datetime import datetime, timezone
import boto3
s3 = boto3.client("s3")

def iter_objects(bucket, prefix):
    paginator = s3.get_paginator("list_objects_v2")
    for page in paginator.paginate(Bucket=bucket, Prefix=prefix):
        for obj in page.get("Contents", []):
            yield obj

def is_good_image(bucket, key, min_bytes):
    if key.endswith("/"): return False, "prefix"
    try:
        h = s3.head_object(Bucket=bucket, Key=key)
        size = h["ContentLength"]
        ct = h.get("ContentType", "")
        if size < min_bytes: return False, f"too_small({size})"
        if not ct.startswith("image/"): return False, f"not_image({ct})"
        return True, {"size": size, "ct": ct, "etag": h.get("ETag","")}
    except Exception as e:
        return False, f"head_failed({e})"

def copy_and_sidecar(bucket, src_key, dst_key, meta):
    # Copy the image
    s3.copy_object(Bucket=bucket, CopySource={"Bucket":bucket,"Key":src_key}, Key=dst_key)
    # Sidecar metadata
    side = dst_key + ".json"
    doc = {
        "source_key": src_key,
        "curated_key": dst_key,
        "content_type": meta["ct"],
        "size": meta["size"],
        "etag": meta.get("etag"),
        "checksum": None,
        "curated_at": datetime.now(timezone.utc).isoformat()
    }
    s3.put_object(Bucket=bucket, Key=side, Body=json.dumps(doc, ensure_ascii=False).encode("utf-8"), ContentType="application/json")

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--bucket", required=True)
    ap.add_argument("--min-bytes", type=int, default=4096)
    ap.add_argument("--categories", nargs="+", required=True,
                    help="Category slugs (e.g. pokemon_cards funko_pops diecast_cars ...)")
    args = ap.parse_args()

    total_scanned = total_kept = total_skipped = 0
    for cat in args.categories:
        raw_prefix = f"raw/{cat}/"
        curated_prefix = f"curated/{cat}/"
        print(f"== Category: {cat} ==")
        for obj in iter_objects(args.bucket, raw_prefix):
            key = obj["Key"]; total_scanned += 1
            ok, info = is_good_image(args.bucket, key, args.min_bytes)
            if not ok:
                total_skipped += 1
                print(f"skip {key} -> {info}")
                continue
            filename = os.path.basename(key)
            dst_key = curated_prefix + filename
            copy_and_sidecar(args.bucket, key, dst_key, info)
            total_kept += 1
            print(f"curated {key} -> {dst_key} ({info['ct']} {info['size']}B)")
    print(json.dumps({
        "scanned": total_scanned, "kept": total_kept, "skipped": total_skipped,
        "bucket": args.bucket, "min_bytes": args.min_bytes}, indent=2))

if __name__ == "__main__":
    sys.exit(main())
