#!/usr/bin/env bash
set -euo pipefail

# auto-load env
if [ -f ./supa_test.env ]; then
  set -a; . ./supa_test.env; set +a
fi

# fallback SUPA_REF from config.toml
if [ -z "${SUPA_REF:-}" ] && [ -f supabase/config.toml ]; then
  SUPA_REF=$(awk -F'=' '/^\s*ref\s*=/{gsub(/[ "]/,"",$2); print $2}' supabase/config.toml || true)
fi

: "${SUPA_REF:?Set SUPA_REF (e.g. ykqrruipzmrrvjcvwfgp)}"
: "${ANON_KEY:?Set ANON_KEY (Dashboard → Settings → API → anon)}"

JWT=$(cat .jwt 2>/dev/null || true)
[ -n "$JWT" ] || { echo "❌ Missing ./.jwt — run login_and_get_jwt.sh"; exit 1; }

FN="https://${SUPA_REF}.functions.supabase.co"

BODY=""; CODE=""

call_api () {
  local url="$1" data="$2"
  echo "→ POST $url"
  local RESP
  RESP=$(curl -sS -w '\n%{http_code}' -X POST "$url" \
    -H "Content-Type: application/json" \
    -H "apikey: ${ANON_KEY}" \
    -H "Authorization: Bearer ${JWT}" \
    --data-raw "$data")
  CODE="${RESP##*$'\n'}"
  BODY="${RESP%$'\n'"$CODE"}"
  echo "HTTP $CODE"
  echo "$BODY"
  echo
}

# 1) create
call_api "${FN}/predict-sessions" '{"category":"pokemon"}'
if [ "$CODE" != "200" ]; then echo "❌ Create failed (HTTP $CODE)"; exit 1; fi
SESSION_ID=$(printf '%s' "$BODY" | sed -n 's/.*"id":"\([^"]*\)".*/\1/p' | head -n1)
[ -n "$SESSION_ID" ] || { echo "❌ SESSION_ID not found"; exit 1; }
echo "✅ SESSION_ID=$SESSION_ID"
echo

# 2) complete
call_api "${FN}/predict-complete" "{\"session_id\":\"${SESSION_ID}\",\"mock_seed\":0.72}"
if [ "$CODE" != "200" ] || ! printf '%s' "$BODY" | grep -q '"status":"done"'; then
  echo "❌ Complete failed (HTTP $CODE)"; exit 1
fi
echo "✅ Completed"
echo

# 3) label
call_api "${FN}/predict-label" "{\"session_id\":\"${SESSION_ID}\",\"corrected_title\":\"Pikachu Holo\",\"corrected_condition\":\"Near Mint\",\"corrected_price_eur\":189}"
if [ "$CODE" != "200" ] || ! printf '%s' "$BODY" | grep -q '"label":'; then
  echo "❌ Label failed (HTTP $CODE)"; exit 1
fi
echo "✅ Label saved"
