import { useMemo } from 'react';
import { useColorScheme } from 'react-native';

type ThemeMode = 'light' | 'dark';

export type AppTheme = {
  mode: ThemeMode;
  colors: {
    // background surfaces
    bg: string;
    card: string;

    // text
    text: string;
    mutedText: string;

    // brand / accents (Tiffany-ish + navy)
    primary: string;
    navy: string;

    // misc
    border: string;
  };
};

const LIGHT: AppTheme['colors'] = {
  bg: '#E7FBFF',
  card: '#FFFFFF',
  text: '#0B1B3A',
  mutedText: '#415A77',
  primary: '#3EE6F2',
  navy: '#0B1B3A',
  border: '#D6EAF0',
};

// Dark mode kept “non-black” (navy-based) to match your “no pure black UI” rule
const DARK: AppTheme['colors'] = {
  bg: '#061225',
  card: '#0A1B34',
  text: '#EAF6FF',
  mutedText: '#A9C3D9',
  primary: '#3EE6F2',
  navy: '#061225',
  border: '#123255',
};

export function useAppTheme(): AppTheme {
  const scheme = useColorScheme();
  const mode: ThemeMode = scheme === 'dark' ? 'dark' : 'light';

  return useMemo(() => {
    return { mode, colors: mode === 'dark' ? DARK : LIGHT };
  }, [mode]);
}
