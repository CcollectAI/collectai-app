/**
 * useAppTheme
 *
 * Adapter hook so we can safely use theming without depending on the
 * exact shape of "@/theme". It:
 * - uses theme.useTheme() if it exists
 * - otherwise falls back to theme.colors/spacing/radii
 * - otherwise uses simple defaults
 *
 * This avoids runtime "useTheme is not a function" crashes coming from
 * new screens.
 */

import * as Theme from '@/theme';

type ThemeLike = {
  colors?: Record<string, any>;
  spacing?: Record<string, number>;
  radii?: Record<string, number>;
};

const defaultColors: Record<string, any> = {
  background: '#f5f5f5',
  card: '#ffffff',
  surface: '#f3f4f6',
  text: '#111827',
  mutedText: '#6b7280',
  border: '#e5e7eb',
  primary: '#0ea5e9',
  primarySoft: '#e0f2fe',
  onPrimary: '#ffffff',
  success: '#16a34a',
  error: '#b91c1c',
  warning: '#f59e0b',
};

const defaultSpacing: Record<string, number> = {
  xs: 4,
  sm: 8,
  md: 12,
  lg: 16,
  xl: 24,
};

const defaultRadii: Record<string, number> = {
  sm: 6,
  md: 10,
  lg: 14,
  full: 999,
};

export function useAppTheme() {
  const anyTheme = Theme as any;

  // If the project already defines a hook, use it directly.
  if (typeof anyTheme.useTheme === 'function') {
    return anyTheme.useTheme();
  }

  // Otherwise, adapt whatever exports exist.
  const base: ThemeLike = anyTheme as ThemeLike;

  return {
    colors: base.colors ?? defaultColors,
    spacing: base.spacing ?? defaultSpacing,
    radii: base.radii ?? defaultRadii,
  };
}

export default useAppTheme;
