/**
 * Portfolio analytics + status + leaderboard core.
 * Pure data / math, no React or Supabase in here.
 */

export type Currency = 'EUR';

export type PortfolioItem = {
  id: string;
  title: string;
  category: string;
  /**
   * Purchase / cost basis in EUR.
   */
  costBasis: number;
  /**
   * Current estimated value in EUR.
   */
  currentValue: number;
  /**
   * Optional rarity score: 0–1 (0 = common, 1 = very rare).
   */
  rarityScore?: number;
  /**
   * Collection key, e.g. "pokemon-base-set-1", "funko-marvel-2023".
   */
  collectionKey?: string;
  /**
   * Whether this item is considered part of a tracked set.
   */
  inTrackedSet?: boolean;
};

export type CollectionDefinition = {
  key: string;              // e.g. 'pokemon-base-set-1'
  label: string;            // e.g. 'Pokémon Base Set'
  /**
   * Total count of items required for a complete set.
   */
  requiredItemCount: number;
};

export type PLPoint = {
  label: string;   // e.g. 'D-11', 'Now'
  value: number;   // portfolio value at that snapshot
};

export type CategoryAllocation = {
  category: string;
  value: number;
  pct: number;     // 0–1
};

export type PLCard = {
  currency: Currency;
  startValue: number;
  currentValue: number;
  plAbs: number;
  plPct: number;   // +/- %
};

export type WinnerLoser = {
  id: string;
  title: string;
  category: string;
  costBasis: number;
  currentValue: number;
  /**
   * Absolute P/L in EUR.
   */
  plAbs: number;
  /**
   * P/L % relative to cost basis.
   */
  plPct: number;
};

export type CompletenessStats = {
  totalTrackedCollections: number;
  completeCollections: number;
  /**
   * 0–1 completeness across all tracked collections.
   */
  completenessScore: number;
};

export type RarityStats = {
  /**
   * Average rarity score of items with defined rarityScore.
   */
  avgRarityScore: number; // 0–1
  /**
   * Proportion of items above a "rare" threshold (e.g. 0.7).
   */
  rareShare: number;      // 0–1
};

export type StatusTier = 'diamond' | 'gold' | 'silver';

export type StatusBadge = {
  completenessScore: number;  // 0–1
  rarityScore: number;        // 0–1
  /**
   * Combined points from completeness + rarity (0–100).
   */
  points: number;
  tier: StatusTier;
};

export type LeaderboardEntry = {
  userId: string;
  displayName: string;
  status: StatusBadge;
};

export type PortfolioSnapshot = {
  plCard: PLCard;
  series: PLPoint[];
  allocations: CategoryAllocation[];
  winners: WinnerLoser[];
  losers: WinnerLoser[];
  completeness: CompletenessStats;
  rarity: RarityStats;
  status: StatusBadge;
};

/**
 * Computes P/L card given start & current.
 */
export function computePLCard(startValue: number, currentValue: number): PLCard {
  const plAbs = currentValue - startValue;
  const plPct = startValue > 0 ? (plAbs / startValue) * 100 : 0;
  return {
    currency: 'EUR',
    startValue,
    currentValue,
    plAbs,
    plPct,
  };
}

/**
 * Takes a list of items and produces category allocation summary.
 */
export function computeCategoryAllocations(items: PortfolioItem[]): CategoryAllocation[] {
  const byCategory: Record<string, number> = {};
  for (const item of items) {
    byCategory[item.category] = (byCategory[item.category] || 0) + item.currentValue;
  }
  const total = Object.values(byCategory).reduce((sum, v) => sum + v, 0) || 1;
  return Object.entries(byCategory)
    .map(([category, value]) => ({
      category,
      value,
      pct: value / total,
    }))
    .sort((a, b) => b.value - a.value);
}

/**
 * Derive winners / losers using costBasis vs currentValue.
 */
export function computeWinnersAndLosers(
  items: PortfolioItem[],
  limit = 5,
): { winners: WinnerLoser[]; losers: WinnerLoser[] } {
  const rows: WinnerLoser[] = items
    .filter((i) => i.costBasis > 0)
    .map((i) => {
      const plAbs = i.currentValue - i.costBasis;
      const plPct = (plAbs / i.costBasis) * 100;
      return {
        id: i.id,
        title: i.title,
        category: i.category,
        costBasis: i.costBasis,
        currentValue: i.currentValue,
        plAbs,
        plPct,
      };
    });

  const winners = [...rows]
    .sort((a, b) => b.plPct - a.plPct)
    .slice(0, limit);

  const losers = [...rows]
    .sort((a, b) => a.plPct - b.plPct)
    .slice(0, limit);

  return { winners, losers };
}

/**
 * Compute completeness stats given items + collection definitions.
 */
export function computeCompleteness(
  items: PortfolioItem[],
  collections: CollectionDefinition[],
): CompletenessStats {
  if (!collections.length) {
    return {
      totalTrackedCollections: 0,
      completeCollections: 0,
      completenessScore: 0,
    };
  }

  const itemsByCollection: Record<string, number> = {};
  for (const item of items) {
    if (!item.collectionKey || !item.inTrackedSet) continue;
    itemsByCollection[item.collectionKey] =
      (itemsByCollection[item.collectionKey] || 0) + 1;
  }

  let complete = 0;
  let totalScore = 0;
  for (const def of collections) {
    const count = itemsByCollection[def.key] || 0;
    const fraction = Math.min(1, def.requiredItemCount > 0 ? count / def.requiredItemCount : 0);
    totalScore += fraction;
    if (fraction >= 1) complete++;
  }

  const overall = totalScore / collections.length;
  return {
    totalTrackedCollections: collections.length,
    completeCollections: complete,
    completenessScore: overall, // 0–1
  };
}

/**
 * Compute rarity stats from items.
 */
export function computeRarityStats(items: PortfolioItem[]): RarityStats {
  const withRarity = items.filter((i) => typeof i.rarityScore === 'number');
  if (!withRarity.length) {
    return {
      avgRarityScore: 0,
      rareShare: 0,
    };
  }
  const rareThreshold = 0.7;
  const sum = withRarity.reduce((s, i) => s + (i.rarityScore || 0), 0);
  const avg = sum / withRarity.length;
  const rareCount = withRarity.filter((i) => (i.rarityScore || 0) >= rareThreshold).length;
  return {
    avgRarityScore: avg,
    rareShare: rareCount / withRarity.length,
  };
}

/**
 * Combine completeness + rarity into a points + tier badge.
 *
 * - Completeness weight: 60%
 * - Rarity weight: 40%
 *
 * Tiers:
 * - Diamond: points >= 80
 * - Gold:    points >= 50
 * - Silver:  otherwise
 */
export function computeStatusBadge(
  completeness: CompletenessStats,
  rarity: RarityStats,
): StatusBadge {
  const c = completeness.completenessScore; // 0–1
  const r = rarity.avgRarityScore;          // 0–1

  const completenessPoints = c * 60; // 0–60
  const rarityPoints = r * 40;       // 0–40
  const points = completenessPoints + rarityPoints; // 0–100

  let tier: StatusTier;
  if (points >= 80) tier = 'diamond';
  else if (points >= 50) tier = 'gold';
  else tier = 'silver';

  return {
    completenessScore: c,
    rarityScore: r,
    points,
    tier,
  };
}

/**
 * Convert a list of users + items into leaderboard entries.
 * Here we just take a list of already-computed badges and sort.
 */
export function computeLeaderboard(
  entries: LeaderboardEntry[],
): LeaderboardEntry[] {
  return [...entries].sort((a, b) => b.status.points - a.status.points);
}

/**
 * DEMO: build a full PortfolioSnapshot from items + collectionDefs.
 * In your real flow, you will plumb Supabase / backend data into this.
 */
export function buildPortfolioSnapshotDemo(
  items: PortfolioItem[],
  collections: CollectionDefinition[],
): PortfolioSnapshot {
  const allocations = computeCategoryAllocations(items);
  const currentValue = allocations.reduce((s, a) => s + a.value, 0);
  const startValue = Math.max(1, currentValue * 0.7); // rough backward inference

  const plCard = computePLCard(startValue, currentValue);
  const { winners, losers } = computeWinnersAndLosers(items);
  const completeness = computeCompleteness(items, collections);
  const rarity = computeRarityStats(items);
  const status = computeStatusBadge(completeness, rarity);

  // For now: build a synthetic 12-point series between start & current.
  const series: PLPoint[] = [];
  const steps = 12;
  for (let i = 0; i < steps; i++) {
    const t = i / (steps - 1);
    const value =
      startValue +
      (currentValue - startValue) * (0.6 * t + 0.4 * t * t); // ease-out-ish
    const label = i === steps - 1 ? 'Now' : `D-${steps - 1 - i}`;
    series.push({ label, value: Math.round(value) });
  }

  return {
    plCard,
    series,
    allocations,
    winners,
    losers,
    completeness,
    rarity,
    status,
  };
}
