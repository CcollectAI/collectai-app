import React, { useCallback, useEffect, useState } from 'react'
import { View, Text, TextInput, Button, ActivityIndicator, Alert } from 'react-native'
import { callEdge } from '@/lib/api'
import { useSession } from '@/hooks/useSession' // assume you have a safe stub that never returns undefined

type PrefillResp = { ok: true; prefill: { title: string|null; category: string; guess_confidence: number; attrs: Record<string, any> } }

export default function AddScreen() {
  const { jwt, anonKey } = useSession()
  const [imageUrl, setImageUrl] = useState<string | null>(null)
  const [category, setCategory] = useState<string>('Pokemon')
  const [title, setTitle] = useState<string>('')
  const [condition, setCondition] = useState<string>('NM')
  const [valueEUR, setValueEUR] = useState<string>('') // string so we can bind input
  const [prefillLoading, setPrefillLoading] = useState(false)
  const [confidence, setConfidence] = useState<number | null>(null)

  // Merge helper: only fill empty fields
  const mergePrefill = useCallback((p: PrefillResp['prefill']) => {
    if (!title && p.title) setTitle(p.title)
    if (!category && p.category) setCategory(p.category)
    if (!condition && (p.attrs?.condition)) setCondition(p.attrs.condition)
    if (!valueEUR && (p.attrs?.predicted_value_eur != null)) setValueEUR(String(p.attrs.predicted_value_eur))
    setConfidence(p.guess_confidence ?? null)
  }, [title, category, condition, valueEUR])

  const tryPrefill = useCallback(async () => {
    if (!jwt || !anonKey) return
    if (!category) return
    setPrefillLoading(true)
    const resp = await callEdge<PrefillResp>('add-prefill', jwt, anonKey, { category, image_url: imageUrl })
    setPrefillLoading(false)
    if (!resp.ok) {
      // non-fatal
      console.warn('add-prefill error', resp.error)
      return
    }
    mergePrefill((resp.data as any).prefill)
  }, [jwt, anonKey, category, imageUrl, mergePrefill])

  // Trigger when category changes or image selected
  useEffect(() => {
    tryPrefill()
  }, [category, imageUrl])

  return (
    <View style={{ padding: 16 }}>
      <Text style={{ fontSize: 18, fontWeight: '600', marginBottom: 8 }}>Add Item</Text>

      {/* Category (simplified) */}
      <Text>Category</Text>
      <TextInput
        value={category}
        onChangeText={setCategory}
        placeholder="Pokemon / Funko / Diecast"
        style={{ borderWidth: 1, padding: 8, marginBottom: 8 }}
      />

      {/* Title */}
      <Text>Title</Text>
      <TextInput
        value={title}
        onChangeText={setTitle}
        placeholder="e.g., Pikachu VMAX (Rainbow)"
        style={{ borderWidth: 1, padding: 8, marginBottom: 8 }}
      />

      {/* Condition */}
      <Text>Condition</Text>
      <TextInput
        value={condition}
        onChangeText={setCondition}
        placeholder="e.g., NM"
        style={{ borderWidth: 1, padding: 8, marginBottom: 8 }}
      />

      {/* Value */}
      <Text>Value (EUR)</Text>
      <TextInput
        value={valueEUR}
        onChangeText={setValueEUR}
        keyboardType="decimal-pad"
        placeholder="e.g., 55.00"
        style={{ borderWidth: 1, padding: 8, marginBottom: 8 }}
      />

      {/* Prefill status */}
      <View style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
        {prefillLoading ? <ActivityIndicator /> : null}
        {confidence != null ? <Text>Prefill confidence: {(confidence*100).toFixed(0)}%</Text> : null}
      </View>

      <View style={{ height: 12 }} />
      <Button title="Save" onPress={() => Alert.alert('Saved (mock)')} />
    </View>
  )
}
