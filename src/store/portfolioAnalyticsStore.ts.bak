  PortfolioItem,
  CollectionDefinition,
  PortfolioSnapshot,
  buildPortfolioSnapshotDemo,
} from '@/analytics/portfolioMetrics';

/**
 * Public type used by screens that want analytics data.
 */
export type PortfolioAnalyticsSnapshot = PortfolioSnapshot;

/**
 * DEMO items & collections – replace with live data wiring later.
