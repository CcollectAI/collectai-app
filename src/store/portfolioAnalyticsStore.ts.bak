const demoCollections: CollectionDefinition[] = [
  {
    key: 'pokemon-base-set',
    label: 'Pokémon Base Set (Demo)',
    requiredItemCount: 15,
  },
  {
    key: 'funko-marvel',
    label: 'Funko Marvel (Demo)',
    requiredItemCount: 10,
  },
];

/**
 * Base helper: full analytics snapshot.
 * Later you can swap this to pull Supabase / backend data but keep this shape.
 */
export function getPortfolioAnalyticsDemo(): PortfolioAnalyticsSnapshot {
  return buildPortfolioSnapshotDemo(demoItems, demoCollections);
}

// --- API expected by the existing Analytics tab ---

/**
 * P/L card (start vs current, € and %).
 */
export async function fetchPortfolioPL() {
  const snapshot = getPortfolioAnalyticsDemo();
  return snapshot.plCard;
}

/**
 * Value-over-time series (~12 points).
 */
export async function fetchPortfolioSeries() {
  const snapshot = getPortfolioAnalyticsDemo();
  return snapshot.series;
}

/**
 * Category allocation bars per category with amounts.
 */
export async function fetchPortfolioAllocations() {
  const snapshot = getPortfolioAnalyticsDemo();
  return snapshot.allocations;
}

/**
 * Winners / losers data if the screen wants to show top movers.
 */
export async function fetchPortfolioWinnersLosers() {
  const snapshot = getPortfolioAnalyticsDemo();
  return {
    winners: snapshot.winners,
    losers: snapshot.losers,
  };
}

/**
 * Full snapshot for any screen that wants everything at once.
 */
export async function fetchPortfolioSnapshot() {
  return getPortfolioAnalyticsDemo();
}
