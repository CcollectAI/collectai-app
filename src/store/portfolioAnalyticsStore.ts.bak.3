/**
 * Synchronous helper used by debug screens or Portfolio:
 * returns a full analytics snapshot (P/L card, series, allocations,
 * winners/losers, completeness/rarity, status tier).
 *
 * Later you can swap this to fetch Supabase / backend data and still
 * keep the same return shape.
 */
export function getPortfolioAnalyticsDemo(): PortfolioAnalyticsSnapshot {
  return buildPortfolioSnapshotDemo(demoItems, demoCollections);
}

// --- Analytics API expected by existing Analytics screen ---

/**
 * Returns the 12-point series the Analytics tab expects.
 * Currently backed by demo data. Later you can swap this to
 * call Supabase/backend and keep the same function name.
 */
export async function fetchPortfolioSeries() {
  const snapshot = getPortfolioAnalyticsDemo();
  return snapshot.series;
}

/**
 * Optional helper: full snapshot for any screen that wants
 * P/L card, series, allocations, winners/losers, status.
 */
export async function fetchPortfolioSnapshot() {
  return getPortfolioAnalyticsDemo();
}
