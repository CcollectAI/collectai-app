import React, { useMemo, useState } from "react";
import { View, Text, PanResponder } from "react-native";
import Svg, { Path, Circle } from "react-native-svg";
import * as d3 from "d3-shape";

type Props = {
  data: number[];
  width: number;
  height: number;
  color: string;
  textColor: string;
};

export default function InteractiveLineChart({
  data,
  width,
  height,
  color,
  textColor,
}: Props) {
  const [hoverIndex, setHoverIndex] = useState<number | null>(null);

  const xScale = useMemo(
    () => d3.scaleLinear().domain([0, data.length - 1]).range([0, width]),
    [data, width]
  );

  const yScale = useMemo(
    () => d3.scaleLinear().domain([Math.min(...data), Math.max(...data)]).range([height, 0]),
    [data, height]
  );

  const linePath = useMemo(
    () =>
      d3
        .line<number>()
        .x((_, i) => xScale(i))
        .y((d) => yScale(d))
        .curve(d3.curveMonotoneX)(data) as string,
    [data, xScale, yScale]
  );

  const panResponder = PanResponder.create({
    onStartShouldSetPanResponder: () => true,
    onPanResponderMove: (_, gestureState) => {
      const index = Math.round(xScale.invert(gestureState.moveX));
      if (index >= 0 && index < data.length) setHoverIndex(index);
    },
    onPanResponderRelease: () => setHoverIndex(null),
  });

  return (
    <View>
      {hoverIndex !== null && (
        <View style={{ alignItems: "center", paddingBottom: 4 }}>
          <Text style={{ color: textColor, fontSize: 14, fontWeight: "600" }}>
            €{data[hoverIndex].toFixed(2)}
          </Text>
        </View>
      )}

      <View {...panResponder.panHandlers}>
        <Svg width={width} height={height}>
          <Path d={linePath} stroke={color} strokeWidth={2.5} fill="none" />

          {hoverIndex !== null && (
            <Circle
              cx={xScale(hoverIndex)}
              cy={yScale(data[hoverIndex])}
              r={6}
              stroke={color}
              strokeWidth={2}
              fill="white"
            />
          )}
        </Svg>
      </View>
    </View>
  );
}
