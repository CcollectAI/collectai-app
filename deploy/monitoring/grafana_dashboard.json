{
  "title": "Collectors Merge - SLI Overview",
  "timezone": "browser",
  "panels": [
    {
      "type": "graph",
      "title": "HTTP reqs / s",
      "targets": [
        {"expr": "sum(rate(http_requests_total[5m]))", "legendFormat": "rps"}
      ]
    },
    {
      "type": "graph",
      "title": "p95 latency (s)",
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_seconds_bucket[5m])))", "legendFormat": "p95"}
      ]
    },
    {
      "type": "graph",
      "title": "5xx rate",
      "targets": [
        {"expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m]))", "legendFormat": "5xx rps"}
      ]
    }
  ],
  "schemaVersion": 38,
  "version": 1
}
